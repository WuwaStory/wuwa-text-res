    {
      "id": 42,
      "parentId": 41,
      "type": "ChildQuest",
      "dialogs": [
        {
          "flowId": "剧情_3_0_支线_点亮星空",
          "flowIndex": 17,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Jetzt leuchtet das Felsenbild und die Versteinerung ist weg. Ich sollte zurück und mich mit Dari treffen.",
                "en": "The petroglyph is lit now that the statue is gone. I'll head back and meet with Dari.",
                "es": "Ahora que la estatua no está, el petroglifo está iluminado. Volveré con Dari.",
                "fr": "Le pétroglyphe est illuminé maintenant que la statue a disparu. Je vais retourner retrouver Dari.",
                "ja": "{Male=やっぱり、フライフィッシュの石像が消えたことで、この壁画が灯されたんだな。戻ってドーレと合流するか……;Female=やっぱり、フライフィッシュの石像が消えたことで、この壁画が灯されたんだね。戻ってドーレと合流しなきゃ……}",
                "ko": "역시, 비행 물고기 석상이 사라지니 이 벽화도 밝혀졌어. 돌아가서 다리와 합류하자...",
                "th": "จริงด้วย พอรูปปั้นปลาเหินฟ้าหายไป ภาพบนผนังแผ่นนี้ก็สว่างขึ้นแล้ว กลับไปหา Dari ดีกว่า...",
                "zh-Hans": "果然，飞鱼石像消失后，这块壁画就被点亮了，回去和多蕾汇合吧……",
                "zh-Hant": "果然，飛魚石像消失後，這塊壁畫就被點亮了，回去和多蕾匯合吧……"
              },
              "id": 1,
              "speaker": {
                "id": 750088,
                "name": {
                  "zh-Hans": "{PlayerName}"
                }
              }
            }
          ]
        }
      ]
    }
