                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Hat das geholfen?",
                    "en": "Did that help?",
                    "es": "¿Te ha ayudado?",
                    "fr": "Ça t'a aidée ?",
                    "ja": "{Male=緊張はほぐれたか？;Female=緊張はほぐれた？}",
                    "ko": "도움이 됐나요?",
                    "th": "รู้สึกได้ผลมั้ย?",
                    "zh-Hans": "感觉有用吗？",
                    "zh-Hant": "感覺有用嗎？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Lass es mich noch mal versuchen …",
                "en": "Let me try again...",
                "es": "Déjame ver...",
                "fr": "On va voir…",
                "ja": "やってみますね……",
                "ko": "제가 해볼게요...",
                "th": "ฉันจะลองดู...",
                "zh-Hans": "我试试看……",
                "zh-Hant": "我試試看……"
              },
              "id": 2,
              "speaker": {
                "id": 700796,
                "name": {
                  "zh-Hans": "紧张的辩论社成员"
                },
                "entity": {
                  "entityId": 320701087,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "name": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "areaId": 36170,
                  "position": {
                    "x": -61121,
                    "y": -553559,
                    "z": 36250
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ähem, die Befürworter argumentieren, dass der Geschmack des Essens in der Cafeteria keinen Einfluss auf die Lerneffizienz habe.",
                "en": "Ahem, the yes side argues that the taste of cafeteria food is irrelevant to learning efficiency.",
                "es": "*Ejem*, la postura en contra argumenta que el sabor de la comida de la cafetería no influye en la eficiencia del aprendizaje.",
                "fr": "Hum-hum, le camp contre défend l'idée que la nourriture de la cafétéria n'a rien à voir avec l'efficacité de l'apprentissage.",
                "ja": "コホン、否定側の論点によれば、食堂の食べ物の味が学習効率に影響を及ぼすことはない、ということになりますね？",
                "ko": "크흠, 반대 측에서는 식당에서 제공하는 급식의 맛이 공부 효율에 영향을 끼치지 않다고 주장합니다",
                "th": "อะแฮ่ม ตามข้อโต้แย้งของฝ่ายค้าน รสชาติอาหารกลางวันในโรงอาหารไม่ได้ส่งผลต่อประสิทธิภาพการเรียนหนังสือ",
                "zh-Hans": "咳咳，根据反方的论点，食堂中餐品的口味不会影响学习效率。",
                "zh-Hant": "咳咳，根據反方的論點，食堂中餐品的口味不會影響學習效率。"
              },
              "id": 3,
              "speaker": {
                "id": 700796,
                "name": {
                  "zh-Hans": "紧张的辩论社成员"
                },
                "entity": {
                  "entityId": 320701087,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "name": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "areaId": 36170,
                  "position": {
                    "x": -61121,
                    "y": -553559,
                    "z": 36250
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Unsere Daten zeigen jedoch, dass die Lerneffizienz in unserer Abteilung um etwa 7 % steigt, wenn die Cafeteria süße Speisen anbietet.",
                "en": "However, according to our data, when the cafeteria provides sweet foods, the learning efficiency in our department increases by about 7%.",
                "es": "Sin embargo, según nuestros datos, cuando la cafetería ofrece comida dulce, la eficiencia del aprendizaje en nuestro departamento se incrementa aproximadamente un 7 %.",
                "fr": "Mais d'après nos données, quand la cafétéria sert de la nourriture sucrée, le taux de réussite dans notre département augmente de 7 %.",
                "ja": "ですが、私たちが採集したデータによると、食堂で甘い物が提供された場合、本学部の学習効率は約7％上がっていました。",
                "ko": "하지만 저희가 수집한 데이터에 따르면, 식당에서 달콤한 음식을 제공할 때, 저희 학부의 공부 효율을 7%가량 높일 수 있다는 사실이 밝혀졌습니다",
                "th": "แต่จากผลสำรวจที่เรารวบรวมมานั้น พบว่าการมีอาหารรสหวานในโรงอาหาร สามารถเพิ่มประสิทธิภาพการเรียนของภาควิชาให้สูงขึ้นประมาณ 7% ได้นะ",
                "zh-Hans": "但根据我们采集到的数据表明，食堂中提供甜味食物时，本学部的学习效率能够提升约7%。",
                "zh-Hant": "但根據我們採集到的數據表明，食堂中提供甜味食物時，本學部的學習效率能夠提升約7%。"
              },
              "id": 4,
              "speaker": {
                "id": 700796,
                "name": {
                  "zh-Hans": "紧张的辩论社成员"
                },
                "entity": {
                  "entityId": 320701087,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "name": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "areaId": 36170,
                  "position": {
                    "x": -61121,
                    "y": -553559,
                    "z": 36250
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Wir gehen davon aus, dass der Zucker den Nährstoffbedarf des Gehirns deckt und die Ausschüttung von Dopamin fördert, was wiederum zu mehr Freude beim Lernen führt …",
                "en": "We presume that sugar satisfies the brain's nutritional needs and promotes dopamine secretion, resulting in increased pleasure from studying...",
                "es": "Presumimos que el azúcar satisface las necesidades nutricionales del cerebro y promueve la secreción de dopamina, lo que da como resultado un mayor placer al estudiar...",
                "fr": "Nous en concluons donc que le sucre répond aux besoins nutritionnels du cerveau et encourage la production de dopamine, ce qui a pour effet d'augmenter le plaisir ressenti lors de l'apprentissage.",
                "ja": "これは、糖質が脳が必要とする栄養を満たしたことで、ドーパミンの分泌が促進され、その結果、学習時により多くの満足感が生まれたものと推定されます。",
                "ko": "이는 당류가 뇌에 필요한 영양을 더 잘 충족시키며 도파민 분비를 촉진시켜, 공부를 할 때 더 많은 즐거움을 얻을 수 있기 때문으로 추정됩니다...",
                "th": "สันนิษฐานว่าน้ำตาลช่วยให้สมองได้รับสารอาหารมากขึ้น แล้วยังช่วยกระตุ้นการหลั่งโดปามีนอีกด้วย จึงทำให้เรารู้สึกเพลิดเพลินมากขึ้นตอนที่เรียนหนังสือ...",
                "zh-Hans": "推定这是由于糖类更能满足大脑营养供给，以及促使多巴胺分泌，导致在学习时能够获得更多的愉悦感……",
                "zh-Hant": "推定這是由於糖類更能滿足大腦營養供給，以及促使多巴胺分泌，導致在學習時能夠獲得更多的愉悅感……"
              },
              "id": 5,
              "speaker": {
                "id": 700796,
                "name": {
                  "zh-Hans": "紧张的辩论社成员"
                },
                "entity": {
