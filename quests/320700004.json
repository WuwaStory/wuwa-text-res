            },
            {
              "text": {
                "de": "Hey! Das war viel besser!",
                "en": "Hey! That's much better!",
                "es": "¡Oye! ¡Me siento mucho mejor!",
                "fr": "Hé, c'est vachement mieux !",
                "ja": "えっ、本当にさっきよりかなり緊張がほぐれたような気がします！",
                "ko": "어, 진짜로 많이 좋아졌네요!",
                "th": "เอ๊ะ ฉันรู้สึกดีขึ้นมากเลย!",
                "zh-Hans": "诶，我感觉真的好多了！",
                "zh-Hant": "欸，我感覺真的好多了！"
              },
              "id": 6,
              "speaker": {
                "id": 700796,
