          "flowIndex": 2,
          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Ich teile die Meinung … der Gegenseite nicht …",
                "en": "I do not s-support the views... of the yes side...",
                "es": "N-no apoyo las ideas... de la postura en contra...",
                "fr": "Je ne soutiens pas les opinions... du côté oui...",
                "ja": "ひ……否定側の主張には……さ、賛成しかねます……",
                "ko": "반... 반대 측 입장에 대해... 이, 이의가 있습니다...",
                "th": "จะ...จากที่ฝ่ายค้านพูดมานั้น... ฉะ...ฉันไม่เห็นด้วย...",
                "zh-Hans": "反……反方所说的……我、我不支持……",
                "zh-Hant": "反……反方所說的……我、我不支持……"
              },
              "id": 1,
              "speaker": {
