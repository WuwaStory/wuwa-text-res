                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "name": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "areaId": 36170,
                  "position": {
                    "x": -61121,
                    "y": -553559,
