                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Was ist los?",
                    "en": "What's wrong?",
                    "es": "¿Algún problema?",
                    "fr": "Qu'y a-t-il ?",
                    "ja": "{Male=どうかしたのか？;Female=どうかしたの？}",
                    "ko": "왜 그러시죠?",
                    "th": "เป็นอะไรไป?",
                    "zh-Hans": "怎么了？",
                    "zh-Hant": "怎麼了？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Äh … ich bin dem Debattierclub gerade erst beigetreten.",
                "en": "Uh... I just... joined the Debate Club.",
                "es": "Eh... hace poco... me uní al Club de Debate.",
                "fr": "Euh… J'ai, euh… rejoint le club de débat.",
                "ja": "……あっ、私最近……弁論同好会に入ったばかりなんです。",
                "ko": "... 아, 제가 최근에... 토론 동호회에 가입했거든요",
                "th": "...เอ่อ ช่วงนี้ฉัน... เพิ่งสมัครเข้าชมรมโต้วาทีน่ะ",
                "zh-Hans": "……啊，我最近……刚加入了辩论社。",
                "zh-Hant": "……啊，我最近……剛加入了辯論社。"
              },
              "id": 3,
              "speaker": {
                "id": 700796,
                "name": {
                  "zh-Hans": "紧张的辩论社成员"
                },
                "entity": {
                  "entityId": 320701087,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "name": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS2_7",
                  "areaId": 36170,
                  "position": {
                    "x": -61121,
                    "y": -553559,
                    "z": 36250
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ich bin eigentlich ziemlich schüchtern … Ein älterer Kommilitone hat mir geraten, dem Debattierclub beizutreten, um meine Kommunikationsfähigkeiten zu verbessern.",
                "en": "I'm a bit shy around people... An upperclassman said that I should join the Debate Club to improve my communication skills.",
                "es": "Soy algo tímida con la gente... Un alumno de un curso superior me aconsejó unirme al Club de Debate para mejorar mis habilidades de comunicación.",
                "fr": "Je suis un peu timide… Une étudiante plus âgée m'a recommandé de rejoindre le club de débat pour améliorer ma communication.",
                "ja": "普段からちょっと人見知りなところがあって……先輩に薦められて弁論同好会に入ったんです。みんなとのコミュニケーション能力を上げられるって言われて。",
