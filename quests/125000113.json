          "talks": [
            {
              "text": {
                "de": "Du legst die Blumen vor dem Grabstein...",
                "en": "You put the flowers in front of the tombstone…",
                "es": "Dejas las flores frente a la lápida...",
                "fr": "Placer le bouquet sur la tombe.",
                "ja": "お墓に花束を供えた……",
                "ko": "묘비 앞에 꽃을 놓는다...",
                "th": "คุณเอาดอกไม้ไปวางไว้หน้าหลุมศพ...",
                "zh-Hans": "把鲜花放在了墓碑前……",
                "zh-Hant": "把鮮花放在了墓碑前……"
              },
              "id": 1
            }
          ]
        }
