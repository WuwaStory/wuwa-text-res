      "dialogs": [
        {
          "flowId": "剧情_每日_吊唁碑林",
          "flowIndex": 6,
          "stateId": 3,
          "talks": [
            {
              "text": {
                "de": "Das ging schnell. War deine Lieferung problemlos?",
                "en": "That's fast. Was your delivery smooth?",
                "es": "¡Qué rápido! ¿Todo bien con la entrega?",
                "fr": "Tu es déjà de retour ! Tout se passe bien ?",
                "ja": "早いな、さすがだ……どうだった？",
                "ko": "방금 떠난 것 같은데 엄청 빨리 돌아왔구먼... 꽃 배달은 잘 되었나?",
                "th": "เร็วจังนะ จัดส่งเรียบร้อยดีไหม?",
                "zh-Hans": "这么快就回来了！不愧是你，送花的这一路还顺利吧。",
                "zh-Hant": "這麼快就回來了！不愧是你，送花的這一路還順利吧。"
              },
              "id": 1,
              "speaker": {
                "id": 1125,
                "name": {
                  "zh-Hans": "公明"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Ohne Probleme.",
                    "en": "Without a hitch.",
                    "es": "Todo fue muy bien.",
                    "fr": "Très bien.",
                    "ja": "問題ない。",
                    "ko": "네, 잘 가져다줬어요",
                    "th": "ราบรื่นไร้ปัญหา",
                    "zh-Hans": "非常顺利。",
                    "zh-Hant": "非常順利。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Super, danke! Wenn sie diese Blume riechen, wissen sie, dass sie immer noch vermisst werden.",
                "en": "Great, thank you! When they smell this flower, they know they are still being missed.",
                "es": "Genial, ¡gracias! Cuando huelan esta flor, sabrán que aún se les extraña.",
                "fr": "C'est super, merci ! En sentant le parfum de ces fleurs, ils sauront qu'ils sont toujours dans nos pensées.",
                "ja": "よかった……これでヤツらも、自分がまだ誰かに思われてるってわかっただろ……",
                "ko": "잘 됐군, 그가 이 꽃의 향기를 맡으면 사람들이 아직도 그리워하고 있다는 걸 알게 될 게야",
                "th": "เยี่ยมเลย! ขอบคุณนะ! เมื่อพวกเขาได้กลิ่นดอกไม้นี้ พวกเขาก็จะรู้ว่ามีคนคิดถึงพวกเขาอยู่",
                "zh-Hans": "那就好，谢谢你！他们闻到这种花的香味，一定知道自己还在被人惦记着呐。",
                "zh-Hant": "那就好，謝謝你！他們聞到這種花的香味，一定知道自己還在被人惦記著呐。"
              },
              "id": 2,
              "speaker": {
                "id": 1125,
                "name": {
                  "zh-Hans": "公明"
                }
              }
            }
          ]
        }
      ]
