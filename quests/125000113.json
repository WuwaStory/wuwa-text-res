      "dialogs": [
        {
          "flowId": "剧情_每日_吊唁碑林",
          "flowIndex": 6,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Rover, lange nicht gesehen. Erinnerst du dich an mich?",
                "en": "Rover, long time no see. Do you remember me?",
                "es": "Errante, hace mucho que no nos vemos. ¿Me recuerdas?",
                "fr": "Nomade, ça fait longtemps, tu te souviens de moi ?",
                "ja": "漂泊者、久しぶりだな。俺のことを覚えてるか？",
                "ko": "방랑자, 오랜만이군. 자네 날 기억하나?",
                "th": "ท่านผู้พเนจร ไม่ได้เจอกันนานเลยนะ เจ้าจำข้าได้หรือไม่?",
                "zh-Hans": "漂泊者，好久不见，你还记得我吗？",
                "zh-Hant": "漂泊者，好久不見，你還記得我嗎？"
              },
              "id": 1,
              "speaker": {
                "id": 1125,
                "name": {
                  "zh-Hans": "公明"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Erinnerst du dich an mich?",
                    "en": "Do you remember me?",
                    "es": "¿Me recuerdas?",
                    "fr": "Vous vous souvenez ?",
                    "ja": "{Male=俺のことわかるの？;Female=私のことわかるの？}",
                    "ko": "절 기억하시나요?",
                    "th": "คุณจำฉันได้เหรอ?",
                    "zh-Hans": "你还记得我？",
                    "zh-Hant": "你還記得我？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ugh, hahaha! Ja, jetzt erinnere ich mich.",
                "en": "Ugh, hahaha! Yes, I remember now.",
                "es": "Ugh, ¡jajaja! Sí, ahora recuerdo.",
                "fr": "Euh... Hahaha, je me souviens maintenant.",
                "ja": "う……ははは、もちろんだ。",
                "ko": "어... 하하하, 지금은 기억나네",
                "th": "เอ่อ ฮ่าๆ ๆ! ใช่ ข้าจำได้แล้ว",
                "zh-Hans": "呃……哈哈哈，现在记得呢。",
                "zh-Hant": "呃……哈哈哈，現在記得呢。"
              },
              "id": 2,
              "speaker": {
                "id": 1125,
                "name": {
                  "zh-Hans": "公明"
                }
              }
            },
            {
              "text": {
                "de": "Entschuldigung, ich habe dir früher viel Ärger bereitet.",
                "en": "Sorry, I caused you a lot of trouble before.",
                "es": "Lo siento, te causé muchos problemas antes.",
                "fr": "Je t'ai causé des ennuis.",
                "ja": "……すまないな、いろいろと迷惑掛けた。",
                "ko": "미안하네, 이전에 자네에게 많은 폐를 끼친 것 같구먼",
                "th": "ขอโทษด้วยนะ ก่อนหน้านี้ข้าสร้างความลำบากไว้ให้เจ้าเยอะเลย",
                "zh-Hans": "不好意思啊，我之前给你造成了很多麻烦。",
                "zh-Hant": "不好意思啊，我之前給你造成了很多麻煩。"
              },
              "id": 3,
              "speaker": {
                "id": 1125,
                "name": {
                  "zh-Hans": "公明"
                }
              }
            },
            {
              "text": {
                "de": "Ich wollte sagen...",
                "en": "I wanted to say…",
                "es": "Quería decir...",
                "fr": "Cette fois, je voulais dire...",
                "ja": "今日は……",
                "ko": "내가 이번에 말하려는 건...",
                "th": "คือข้าอยากจะบอกว่า...",
                "zh-Hans": "我这次是想说……",
                "zh-Hant": "我這次是想說……"
              },
              "id": 4,
              "speaker": {
                "id": 1125,
                "name": {
                  "zh-Hans": "公明"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Blumen liefern?",
                    "en": "Delivering flowers?",
                    "es": "¿Entregar flores?",
                    "fr": "Apporter les fleurs ?",
                    "ja": "また花束？",
                    "ko": "꽃 배달이요?",
                    "th": "เรื่องส่งดอกไม้รึเปล่า?",
                    "zh-Hans": "送花？",
                    "zh-Hant": "送花？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "J-ja, danke für deine Hilfe.",
                "en": "Y-yes, thank you for your help.",
                "es": "S-sí, gracias por tu ayuda.",
                "fr": "Oui, c'est bien ça... mais si tu n'as pas de temps --",
                "ja": "ああ……頼んだ……",
                "ko": "맞네... 미안하네...",
                "th": "ชะ ใช่แล้ว ขอบใจที่ช่วยนะ",
                "zh-Hans": "是啊……麻烦你了……",
                "zh-Hant": "是啊……麻煩你了……"
              },
              "id": 5,
              "speaker": {
                "id": 1125,
                "name": {
                  "zh-Hans": "公明"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Es ist okay. Ich kenne mich schon aus.",
                    "en": "It's okay. I'm already familiar with it.",
                    "es": "Está bien. Ya estoy {Male=acostumbrado;Female=acostumbrada} a esto.",
                    "fr": "C'est bon.",
                    "ja": "もう慣れてるから大丈夫。",
                    "ko": "괜찮아요. 이제 익숙해요",
                    "th": "ไม่เป็นไร ฉันชินแล้วล่ะ",
                    "zh-Hans": "没关系，我已经轻车熟路了。",
                    "zh-Hant": "沒關係，我已經輕車熟路了。"
                  }
                }
              ]
            }
          ]
        }
      ]
