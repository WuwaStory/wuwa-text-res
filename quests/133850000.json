                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Die Segen annehmen.",
                    "en": "Accept the blessings.",
                    "es": "Aceptar las bendiciones.",
                    "fr": "Accepter les bénédictions.",
                    "ja": "祝福を受ける。",
                    "ko": "축복 받아들이기",
                    "th": "รับพร",
                    "zh-Hans": "接受祝福。",
                    "zh-Hant": "接受祝福。"
                  }
                }
              ]
            }
          ]
