{
  "id": 133850004,
  "key": "城区玩法引导-进度",
  "type": "branch",
  "typeId": 7,
  "name": {
    "de": "Kampf um die Banner",
    "en": "Banners Never Fall",
    "es": "Estandartes de la victoria",
    "fr": "Bannières de la victoire",
    "ja": "掲げし誉れの旗",
    "ko": "영원히 휘날리는 깃발",
    "th": "ผืนธงไม่เคยร่วงหล่น",
    "zh-Hans": "旌旗不落",
    "zh-Hant": "旌旗不落"
  },
  "desc": {
    "de": "Erkunde die Kampfgebiete und besetze Kriegsbanner",
    "en": "Warriors of Septimont... Explore the land, fight the strong foes, and set up banners of glory that never fall!",
    "es": "¡{Male=Guerrero;Female=Guerrera} de Septimont, explora, lucha y activa los estandartes!",
    "fr": "Ô brave, explorez la Zone de défi et activez les Bannières.",
    "ja": "セブン・ヒルズの勇者たちよ！探索し、戦い、旗をアクティベートしよう。",
    "ko": "일곱 언덕의 용사들이여! 탐색하고 전투하며 깃발을 활성화하세요",
    "th": "เหล่านักรบแห่งเซปติมอนต์... จงออกสำรวจดินแดน ต่อสู้กับศัตรูผู้แข็งแกร่ง และชูผืนธงแห่งความรุ่งโรจน์อันไม่มีวันร่วงหล่น!",
    "zh-Hans": "七丘的勇士啊，去探索、战斗、激活一面面旌旗吧。",
    "zh-Hant": "七丘的勇士啊，去探索、戰鬥、啟用一面面旌旗吧。"
  },
