          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Die Fisalias sind überhaupt nicht so, wie man munkelt …",
                "en": "The Fisalia's are nothing like the rumors said...",
                "es": "Los Fisalia no son para nada como dicen los rumores...",
                "fr": "Les Fisalia n'ont rien à voir avec les rumeurs…",
                "ja": "フィサリアファミリー……噂とは全く違う人たちばかりだ……",
                "ko": "피살리아 가문 사람은 소문이랑 많이 다른 거 같은데...",
                "th": "พวก Fisalia นี่ไม่เหมือนที่คนเขาลือกันเลย...",
                "zh-Hans": "翡萨烈家的人看起来跟传闻差别好大啊……",
                "zh-Hant": "翡薩烈家的人看起來跟傳聞差別好大啊……"
              },
              "id": 1,
              "speaker": {
                "id": 800282,
                "name": {
                  "zh-Hans": "多莉亚"
                },
                "entity": {
                  "entityId": 320800068,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM_GWY2_3",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM_GWY2_3",
                  "areaId": 33103,
                  "position": {
                    "x": 1210687,
                    "y": 1162593,
                    "z": 27291
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -160
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Uff, was für ein bitteres Stärkungsmittel!",
                "en": "Whoa, that's one bitter tonic!",
                "es": "¡Vaya, qué tónico tan amargo!",
                "fr": "Ouah, c'est amer !",
                "ja": "う、この薬、苦い！",
                "ko": "와, 이 약 진짜 써!",
                "th": "อึ๋ย... ยานี่ขมชะมัด!",
                "zh-Hans": "哇，这个药好苦！",
                "zh-Hant": "哇，這個藥好苦！"
              },
              "id": 2,
              "speaker": {
                "id": 800282,
                "name": {
                  "zh-Hans": "多莉亚"
                },
                "entity": {
                  "entityId": 320800068,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM_GWY2_3",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM_GWY2_3",
                  "areaId": 33103,
                  "position": {
                    "x": 1210687,
                    "y": 1162593,
                    "z": 27291
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -160
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Haha, macht ihr nur mal. Ich verzichte!",
                "en": "Haha, you lot go on ahead. I'll pass!",
                "es": "¡Ja, ja! No te preocupes por mí. ¡Yo paso!",
                "fr": "Ha ha ! Faites-vous plaisir, moi je passe mon tour !",
                "ja": "ははっ、全部飲んでくれて構わないぞ。",
                "ko": "하하, 너희 마셔. 난 안 마실래!",
                "th": "ฮ่าๆ เชิญดื่มกันตามสบาย ส่วนฉันขอบายละกัน!",
                "zh-Hans": "哈哈，你们喝就行，我就不喝了！",
                "zh-Hant": "哈哈，你們喝就行，我就不喝了！"
              },
              "id": 3,
              "speaker": {
                "id": 750185,
                "name": {
                  "zh-Hans": "格兰"
                },
                "entity": {
                  "entityId": 320800357,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_Mid3_1",
                  "name": "TsEntity_TN_B2_4_七丘_MaleM_Mid3_2",
                  "areaId": 33103,
                  "position": {
                    "x": 1219850,
                    "y": 1164740,
                    "z": 27248
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ich bin kerngesund!",
                "en": "I'm healthy as a horse!",
                "es": "¡Estoy sano como un roble!",
                "fr": "J'ai une santé de fer !",
                "ja": "俺はまだまだ元気だからな！",
                "ko": "내 몸은 아주 좋다고!",
                "th": "ฉันน่ะแข็งแกร่งร้อยแรงม้าอยู่แล้ว!",
                "zh-Hans": "我身体好着呢！",
                "zh-Hant": "我身體好著呢！"
              },
              "id": 4,
              "speaker": {
                "id": 750185,
                "name": {
                  "zh-Hans": "格兰"
                },
                "entity": {
                  "entityId": 320800357,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_Mid3_1",
                  "name": "TsEntity_TN_B2_4_七丘_MaleM_Mid3_2",
                  "areaId": 33103,
                  "position": {
                    "x": 1219850,
                    "y": 1164740,
                    "z": 27248
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Angst vor ein bisschen bitterem Geschmack, Trainer?",
                "en": "Afraid of a bit of bitter taste, Coach?",
                "es": "¿Tienes reparos a tomarte algo un poco amargo, entrenador?",
                "fr": "Peur de l'amertume, M. Gren ?",
                "ja": "グラン先生、もしかして怖いの？",
                "ko": "그렌 스승님, 쓰다고 안 마시는 거죠?",
                "th": "แค่ขมนิดๆ หน่อยๆ ก็กลัวแล้วเหรอโค้ช?",
                "zh-Hans": "格兰老师你不是因为怕苦所以不敢喝吗？",
                "zh-Hant": "格蘭老師你不是因為怕苦所以不敢喝嗎？"
              },
              "id": 5,
              "speaker": {
                "id": 750184,
                "name": {
                  "zh-Hans": "洛莱"
                },
                "entity": {
                  "entityId": 320800083,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM12_7",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM12_7",
                  "areaId": 33103,
                  "position": {
                    "x": 1210630,
                    "y": 1162528,
                    "z": 27303
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 100
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Unsinn! Seit wann kommt ein Gladiator denn nicht mit ein bisschen Bitterkeit klar?",
                "en": "Nonsense! Since when a Gladiator can't take a little bitterness?",
                "es": "¡Patrañas! ¿Desde cuándo le asusta a un gladiador un poco de amargor?",
                "fr": "Pas du tout ! Depuis quand un gladiateur ne peut-il pas gérer un peu d'amertume ?",
                "ja": "セブン・ヒルズのグラディエーターが、そんなもの恐れるわけないだろう！",
                "ko": "또 헛소리, 일곱 언덕의 검투사가 쓴 맛을 못 견딜 리가 있나?",
                "th": "เหลวไหลน่า! กลาดิเอเตอร์จะกลัวความขมแค่นี้ได้ยังไง?",
                "zh-Hans": "又瞎说，七丘的角斗士还有吃不了苦的？",
                "zh-Hant": "又胡說，七丘的角鬥士還有吃不了苦的？"
              },
              "id": 6,
              "speaker": {
                "id": 750185,
                "name": {
                  "zh-Hans": "格兰"
                },
                "entity": {
                  "entityId": 320800357,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_Mid3_1",
                  "name": "TsEntity_TN_B2_4_七丘_MaleM_Mid3_2",
                  "areaId": 33103,
                  "position": {
                    "x": 1219850,
                    "y": 1164740,
                    "z": 27248
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Na, dann mal los. Du hast beim letzten Mal schon zur Hälfte in der Dunklen Flut gesteckt.",
                "en": "Well, have at it then. You were halfway through the Dark Tide last time.",
                "es": "Bueno, entonces tómatelo. La última vez, la Marea Oscura casi se te traga.",
                "fr": "Essayez alors. Vous n'êtes pas allé jusqu'au bout l'autre fois, avec la Marée noire.",
                "ja": "じゃあ早く飲みなさいね！この前、黒潮に半分くらい呑み込まれかけていたんだもん。",
                "ko": "얼른 마셔요. 전에 <ano=검은 파도>흑조(黑潮)</ano>에 절반쯤 빠졌잖아요!",
                "th": "งั้นก็ดื่มเลยสิ คราวก่อนโค้ชก็ลงไปว่ายอยู่ในคลื่นทมิฬมารอบนึงแล้วนี่นา",
                "zh-Hans": "快喝啦，你之前半个人都掉到黑潮里了！",
                "zh-Hant": "快喝啦，你之前半個人都掉到黑潮裡了！"
              },
              "id": 7,
              "speaker": {
                "id": 750184,
                "name": {
                  "zh-Hans": "洛莱"
                },
                "entity": {
                  "entityId": 320800083,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM12_7",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM12_7",
                  "areaId": 33103,
                  "position": {
                    "x": 1210630,
                    "y": 1162528,
                    "z": 27303
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 100
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Keine Sorge. Die Apothekerin meinte, es sei gar nicht so bitter, wie du denkst. Und selbst der Champion hat etwas davon getrunken.",
                "en": "Don't worry. The pharmacist says it's not as bitter as you'd think. Even the Champion had some.",
                "es": "No te preocupes. La farmacéutica dice que no es tan amargo como piensas. Hasta {Male=el Campeón;Female=la Campeona} tomó un poco.",
                "fr": "Ne vous en faites pas. La pharmacienne a dit que ce n'était pas si amer que ça. Même {Male=le Champion;Female=la Championne} en a bu.",
                "ja": "大丈夫だって、薬剤師も苦くないって言ってた。それに、チャンピオン様もこれを飲んだのよ。",
                "ko": "진짜 괜찮아요, 약사님이 이건 안 쓰다고 하셨어요. 챔피언님도 드셨던 거라니까요",
                "th": "ไม่มีอะไรหรอกน่า เภสัชกรบอกว่าไม่ได้ขมอย่างที่คิดนะ แชมเปี้ยนยังดื่มเลย",
                "zh-Hans": "没事的没事的，我听药师说这个不苦的，冠军大人之前也喝过。",
                "zh-Hant": "沒事的沒事的，我聽藥師說這個不苦的，冠軍大人之前也喝過。"
              },
              "id": 8,
              "speaker": {
                "id": 750184,
                "name": {
                  "zh-Hans": "洛莱"
                },
                "entity": {
                  "entityId": 320800083,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM12_7",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM12_7",
                  "areaId": 33103,
                  "position": {
                    "x": 1210630,
                    "y": 1162528,
                    "z": 27303
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 100
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Es ist überhaupt nicht bitter.",
                    "en": "It's not bitter at all.",
                    "es": "No está amargo en absoluto.",
                    "fr": "C'est pas du tout amer.",
                    "ja": "{Male=甘かった。;Female=甘かったよ。}",
                    "ko": "하나도 안 써요",
                    "th": "มันไม่ขมเลยนะ",
                    "zh-Hans": "不苦。",
                    "zh-Hant": "不苦。"
                  }
                },
                {
                  "text": {
                    "de": "Es ist nichts im Vergleich zur Alternative.",
                    "en": "It's nothing compared to the alternative.",
                    "es": "No es nada comparado con la alternativa.",
                    "fr": "C'est rien par rapport à l'autre option.",
                    "ja": "結果としては甘かった。",
                    "ko": "후폭풍에 비하면 확실히 안 써요",
                    "th": "เทียบกับอย่างอื่นแล้ว ไม่ขมสักนิด",
                    "zh-Hans": "相比后果，确实不苦。",
                    "zh-Hant": "相比後果，確實不苦。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Nicht bitter? Na schön, dann her damit!",
                "en": "Not bitter? Fine, hit me!",
                "es": "¿No está amargo? ¡Ok, pues dame!",
                "fr": "Pas amer ? OK, j'essaie.",
                "ja": "甘い……いや、俺の発言が甘かったという意味だ。わかった、薬をくれ。",
                "ko": "안 쓰다는 거지... 아, 아니, 가득 따라!",
                "th": "ไม่ขมเหรอ? ได้ เอามาเลย!",
                "zh-Hans": "不苦啊，哦我是说，满上！",
                "zh-Hant": "不苦啊，哦我是說，滿上！"
              },
