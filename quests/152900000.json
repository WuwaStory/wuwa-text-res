      "dialogs": [
        {
          "flowId": "剧情_拉古纳_自由广场生态",
          "flowIndex": 1,
          "stateId": 9,
          "talks": [
            {
              "text": {
                "de": "Hallo … Ich wünsche einen wunderschönen Tag hier in Ragunna!",
                "en": "Hello... a pleasant day to you here in Ragunna!",
                "es": "Hola... ¡vaya día más maravilloso hace sobre Raguna!",
                "fr": "Bonjour... Je vous souhaite une agréable journée à Ragunna !",
                "ja": "こ…こんにちは。ラグーナで素敵な一日を！",
                "ko": "아, 안녕, 라군나에서 좋은 하루 보내길 바래!",
                "th": "สวัสดี... ขอให้เป็นวันที่ดีในรากูนน่าแห่งนี้นะ!",
                "zh-Hans": "您……您好，祝您在拉古那度过美好的一天！",
                "zh-Hant": "您……您好，祝您在拉古那度過美好的一天！"
              },
              "id": 1,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Was war es, dass du eben rezitiert hast?",
                    "en": "What were you just reciting?",
                    "es": "¿Qué estabas recitando?",
                    "fr": "Que récitiez-vous à l'instant ?",
                    "ja": "{Male=さっき朗読したのは何なのか？;Female=さっき朗読したのは何なの？}",
                    "ko": "방금 읽었던 건 뭐예요?",
                    "th": "เมื่อกี้ท่องอะไรเหรอ?",
                    "zh-Hans": "你刚才朗诵的是什么？",
                    "zh-Hant": "你剛才朗誦的是什麼？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ach … nichts weiter, nur ein wenig Gebrabbel.",
                "en": "Oh... nothing, just some gibberish.",
                "es": "Nada, solo un galimatías.",
                "fr": "Oh... rien, juste du charabia.",
                "ja": "な…なんでもない。私の独り言でしかない。",
                "ko": "아.. 아니, 그냥 혼자 헛소리한 거야",
                "th": "อ้อ... ไม่มีอะไร แค่พูดไปเรื่อยน่ะ",
                "zh-Hans": "没……没什么，只是我的胡言乱语。",
                "zh-Hant": "沒……沒什麼，只是我的胡言亂語。"
              },
              "id": 2,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Was meinst du damit, dass es Ärger geben wird?",
                    "en": "What do you mean by \"trouble will come knocking?\"",
                    "es": "¿Qué quieres decir con «los problemas llamarán a la puerta»?",
                    "fr": "Que voulez-vous dire par « les ennuis viendront frapper à la porte » ?",
                    "ja": "「やっかいなことが降りかかってくる」って？",
                    "ko": "「아니면 귀찮은 일이 생길 거야」?",
                    "th": "หมายถึงอะไรที่ว่า \"ปัญหาจะมาเยือน\" น่ะ?",
                    "zh-Hans": "“麻烦会找上我们”？",
                    "zh-Hant": "「麻煩會找上我們」？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Bitte, vergiss einfach, was du gehört hast.",
                "en": "Please, forget what you heard.",
                "es": "Por favor, olvida lo que escuchaste.",
                "fr": "Oubliez ce que vous avez entendu, je vous prie.",
                "ja": "どうか今聞いたことを全部忘れてください。",
                "ko": "부탁이야! 들은 건 전부 잊어버려 줘",
                "th": "ขอร้องล่ะ ช่วยลืมที่คุณได้ยินไปเถอะ",
                "zh-Hans": "您行行好，忘记您听到的一切吧。",
                "zh-Hant": "您行行好，忘記您聽到的一切吧。"
              },
              "id": 3,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ich will nicht an Bord des Pilgerschiffes gehen müssen. Ich habe eine Familie zu versorgen!",
                "en": "I don't want to board the Pilgrim's Sail. I have a family to support!",
                "es": "No quiero subir a bordo de la Travesía del Peregrino. ¡Tengo una familia que mantener!",
                "fr": "Je ne veux pas embarquer sur le navire de pèlerins. J'ai une famille à nourrir !",
                "ja": "巡礼船に乗りたくない、家族を養わないといけないんだ。",
                "ko": "난 순례선에 끌려가고 싶지 않아, 부양할 가족이 있다고!",
                "th": "ฉันไม่อยากขึ้นเรือผู้แสวงบุญ ฉันมีครอบครัวที่ต้องดูแลนะ!",
                "zh-Hans": "我不想登上朝圣船，我还有一大家子需要养活！",
                "zh-Hant": "我不想登上朝聖船，我還有一大家子需要養活！"
              },
              "id": 4,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Vergiss diese verbotenen Wörter. Sie sind Flüche von einem geheimnisvollen Dramatiker.",
                "en": "Forget these forbidden words. They're curses from a mysterious playwright.",
                "es": "Olvida esas palabras prohibidas. Son palabrería de un dramaturgo misterioso.",
                "fr": "Oubliez ces mots interdits. Ce sont des malédictions d'un dramaturge mystérieux.",
                "ja": "禁忌の言葉を忘れてください。謎の劇作家が残した呪いなんだ。",
                "ko": "이 금기된 문구들은 제발 잊어 줘, 그건 신비한 극작가가 남긴 저주야",
                "th": "ลืมคำต้องห้ามพวกนี้ไปซะ มันคือคำสาปของนักเขียนบทละครลึกลับคนหนึ่ง",
                "zh-Hans": "请您忘记这些禁忌的词句吧，这是神秘剧作家留下的诅咒。",
                "zh-Hant": "請您忘記這些禁忌的詞句吧，這是神秘劇作家留下的詛咒。"
              },
              "id": 5,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Er hat das Volk von Ragunna mit seinen gekürzten Sonettversen verflucht und alles hier verdammt … und jetzt bin ich das nächste Ziel.",
                "en": "He cursed the people of Ragunna with his truncated sonnet verses, condemning everything here... and now, I'm the next target.",
                "es": "Maldijo al pueblo de Raguna con sus sonetos rotos, condenándolo todo aquí... y ahora, yo soy el próximo objetivo.",
                "fr": "Il a maudit le peuple de Ragunna avec ses vers de sonnet tronqués, nous condamnant tous ici... et je suis la prochaine cible.",
                "ja": "途切れ途切れの<ano=ソネット>詩</ano>でラグーナ人を、ラグーナのすべてを呪った…今度は私の番だ。",
                "ko": "그는 불완전한 소네트의 저주로 라군나 사람을 저주하고, 라군나의 모든 것을… 아아, 이제는 내 차례야!",
                "th": "เขาได้สาปแช่งผู้คนของรากูนน่าด้วยบทกวีที่ขาดๆ หายๆ ของเขา ประณามทุกสิ่งที่นี่... และตอนนี้ฉันก็เป็นเป้าหมายถัดไป",
                "zh-Hans": "他用残缺的十四行诗诅咒拉古那人，诅咒拉古那的一切……现在轮到我了。",
                "zh-Hant": "他用殘缺的十四行詩詛咒拉古那人，詛咒拉古那的一切……現在輪到我了。"
              },
              "id": 6,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ich … Ich habe eine Familie zu ernähren.",
                "en": "I... I have a family to feed.",
                "es": "Yo... Tengo una familia que alimentar.",
                "fr": "J... J'ai une famille...",
                "ja": "わ…私は家族を養わなければならないんだ。",
                "ko": "나… 난 부양할 가족이 있다고…",
                "th": "ฉัน... ฉันมีครอบครัวที่ต้องเลี้ยงดู",
                "zh-Hans": "我……我还有一大家子需要养活。",
                "zh-Hant": "我……我還有一大家子需要養活。"
              },
              "id": 7,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Amedeo, vergiss das, vergiss, dass du diese Worte gesehen hast.",
                "en": "Amedeo, forget it, forget you saw those words.",
                "es": "Amadeo, olvídalo, olvida que escuchaste esas palabras.",
                "fr": "Amedeo, oublie ça, oublie que tu as vu ces mots.",
                "ja": "アメディオよ、早くさっき見た詩句を忘れるんだ。",
                "ko": "아마데오, 빨리 잊어버려! 빨리 문구를 잊어버리라고!",
                "th": "Amedeo ลืมมันไปเถอะ ลืมไปซะว่าคุณเห็นคำพวกนั้น",
                "zh-Hans": "阿梅代奥，快忘记，快忘记看到的词句。",
                "zh-Hant": "阿梅代奧，快忘記，快忘記看到的詞句。"
              },
              "id": 8,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
                  "entityId": 152900054,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880140",
                  "name": "TsEntity_阿梅代奥",
                  "areaId": 1692,
                  "position": {
                    "x": 683723,
                    "y": 569195,
                    "z": 79
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -110
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Kann ich irgendetwas tun, um zu helfen?",
                    "en": "Is there anything I can do to help?",
                    "es": "¿Puedo hacer algo para ayudar?",
                    "fr": "Je peux faire quelque chose pour vous aider ?",
                    "ja": "{Male=……俺に何かできるか？;Female=……私に何かできるの？}",
                    "ko": "...제가 도와줄 거라도 있나요?",
                    "th": "มีอะไรที่ฉันพอช่วยได้บ้างไหม?",
                    "zh-Hans": "……我能帮上什么吗？",
                    "zh-Hant": "……我能幫上什麼嗎？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Oh, barmherziger Imperator, ich bin in die Tiefen einer unverzeihlichen Sünde gefallen …",
                "en": "O merciful Imperator, I have fallen into the depths of unforgivable sin...",
                "es": "El misericordioso Imperator, he caído en las garras de un pecado imperdonable...",
                "fr": "Ô miséricordieux Imperator, je suis tombé dans les profondeurs du péché impardonnable...",
                "ja": "仁慈なるインペラトルよ、我はもう数え切れない罪の海に、その深淵に堕ちた…",
                "ko": "인자하신 임페라토르여, 전 이미 헤아릴 수 없는 깊은 죄의 바닷속으로 타락했습니다…",
                "th": "โอ้ Imperator ผู้ทรงเมตตา ฉันได้ตกลงสู่ห้วงแห่งบาปที่ไม่อาจอภัยได้...",
                "zh-Hans": "仁慈英白拉多啊，我已堕入了难量其罪的海渊深处……",
                "zh-Hant": "仁慈英白拉多啊，我已墮入了難量其罪的海淵深處……"
              },
              "id": 9,
              "speaker": {
                "id": 900185,
                "name": {
                  "zh-Hans": "阿梅代奥"
                },
                "entity": {
