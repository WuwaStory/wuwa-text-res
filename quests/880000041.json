                  }
                }
              }
            },
            {
              "text": {
                "de": "Hier. Hast du dir verdient!",
                "en": "Here. You earned these!",
                "es": "Toma. ¡Te lo has ganado!",
                "fr": "Voilà, tu les as bien mérités !",
                "ja": "ありがとう。これが報酬だ！",
                "ko": "자, 여기 보수야!",
                "th": "เอาไปสิ คุณสมควรได้รับสิ่งนี้!",
                "zh-Hans": "给，这些是你的报酬！",
                "zh-Hant": "給，這些是你的報酬！"
              },
