      "dialogs": [
        {
          "flowId": "剧情_七丘_竞技场生态",
          "flowIndex": 4,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "… Hast du das verstanden?",
                "en": "...Do you understand everything I've just told you?",
                "es": "... ¿Entendiste?",
                "fr": "... C'est compris ?",
                "ja": "……ここまでは、ちゃんと理解した？",
                "ko": "...지금까지 말한 거 다 이해했지?",
                "th": "...เข้าใจที่ฉันพูดไปเมื่อกี้มั้ยเนี่ย?",
                "zh-Hans": "……以上讲的都明白了吗？",
                "zh-Hant": "……以上講的都明白了嗎？"
              },
              "id": 1,
              "speaker": {
                "id": 850215,
                "name": {
                  "zh-Hans": "帕兰卡"
                },
                "entity": {
                  "entityId": 152850205,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM_JDS_Mid1_5",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM_JDS_Mid1_5",
                  "areaId": 33104,
                  "position": {
                    "x": 1251578,
                    "y": 1185278,
                    "z": 44081
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 140
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Verstanden, Coach! Ich trainiere so hart ich kann und hole mir in vier Jahren die Goldmedaille bei der Meisterschaft!",
                "en": "Understood, ma'am! I'll train harder than ever, and in four years' time, I will snatch that gold medal in the Agon of Champions!",
                "es": "¡Entendido! ¡Entrenaré tanto como pueda y ganaré esa medalla dorada en el campeonato en cuatro años!",
                "fr": "Compris, coach ! Je m'entraînerai d'arrache-pied et je gagnerai la médaille d'or au championnat dans quatre ans !",
                "ja": "はい、コーチ！これからは絶対に厳しい訓練を積んで、4年後のチャンピオンシップで金メダルを取ります！",
                "ko": "네 코치님! 이제부턴 더 열심히 훈련할게요! 4년 후 선수권 대회에서 금메달을 따겠습니다!",
                "th": "เข้าใจครับ! ผมจะฝึกให้หนักยิ่งกว่าเดิม แล้วในอีกสี่ปี ผมจะคว้าเหรียญทองจากอากอนแชมเปี้ยนชิพให้ได้!",
                "zh-Hans": "明白了教练！接下来我一定刻苦训练，我要拿到四年后的那场冠军赛的金牌！",
                "zh-Hant": "明白了教練！接下來我一定刻苦訓練，我要拿到四年後的那場冠軍賽的金牌！"
              },
              "id": 2,
              "speaker": {
                "id": 850216,
                "name": {
                  "zh-Hans": "昆图斯"
                },
                "entity": {
                  "entityId": 152850204,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_JDS1_6",
                  "name": "TsEntity_TN_B2_4_七丘_MaleM_JDS1_6",
                  "areaId": 33104,
                  "position": {
                    "x": 1251499,
                    "y": 1185350,
                    "z": 44081
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -41
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Hervorragende Einstellung! Mit diesem Ehrgeiz kann ich dich zum Champion machen.",
                "en": "That's what I like to hear! With your determination and my guidance. You will become the champion.",
                "es": "¡Excelente respuesta! Ese tipo de determinación puede llevarte a que seas un campeón.",
                "fr": "Bonne réponse ! Avec cette détermination, je ferai de toi un champion.",
                "ja": "その意気よ！その覚悟があるなら、私が必ずタイトルを取らせてあげる。",
                "ko": "좋아! 그런 마음가짐이라면 나도 널 반드시 우승시켜주마",
                "th": "ต้องอย่างนี้สิ! ตั้งใจมุ่งมั่นทำตามที่ฉันสอน แล้วเธอจะได้เป็นผู้ชนะ",
                "zh-Hans": "没错！有这样的决心，我一定带你拿到冠军。",
                "zh-Hant": "沒錯！有這樣的決心，我一定帶你拿到冠軍。"
              },
              "id": 3,
              "speaker": {
                "id": 850215,
                "name": {
                  "zh-Hans": "帕兰卡"
                },
                "entity": {
                  "entityId": 152850205,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM_JDS_Mid1_5",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM_JDS_Mid1_5",
                  "areaId": 33104,
                  "position": {
                    "x": 1251578,
                    "y": 1185278,
                    "z": 44081
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 140
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Sieh dir das hier an. Ich habe ein Trainingsprogramm aus fünf Jahren harter Arbeit und Disziplin und danach eine dreijährige Durchbruchsphase aufgestellt.",
                "en": "First, have a look at this. I've prepared a non-stop, strenuously gruelling multi-year training program",
                "es": "Antes, mira esto. Preparé un programa de cinco años que consiste en determinación y agallas, luego, un período de avances de tres años.",
                "fr": "D'abord, regarde ça. J'ai préparé un programme de cinq ans qui demandera de la détermination et du courage, puis une période de percée de trois ans.",
                "ja": "まずはこれを見て。これはあなたのために用意した、5年分努力すれば3年で飛躍するトレーニング計画よ。",
                "ko": "일단 이거 봐라. 내가 너를 위해 준비한 5년의 분투 3년의 도약이라는 훈련 계획이야",
                "th": "ก่อนอื่น ดูนี่ ฉันเตรียมหลักสูตรฝึกโหดไม่หยุดเหนื่อยไม่หย่อนสำหรับระยะหลายปีไว้ให้แล้ว",
                "zh-Hans": "而首先，来看看这个，这是我为你准备的五年奋斗三年跃升的训练计划。",
                "zh-Hant": "而首先，來看看這個，這是我為你準備的五年奮鬥三年躍升的訓練計劃。"
              },
              "id": 4,
              "speaker": {
                "id": 850215,
                "name": {
                  "zh-Hans": "帕兰卡"
                },
                "entity": {
                  "entityId": 152850205,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM_JDS_Mid1_5",
                  "name": "TsEntity_TN_B2_4_七丘_FemaleM_JDS_Mid1_5",
                  "areaId": 33104,
                  "position": {
                    "x": 1251578,
                    "y": 1185278,
                    "z": 44081
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 140
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ab heute trainieren wir genau nach diesem Plan.",
                "en": "Starting today, we begin training based on this program.",
                "es": "Desde hoy, comenzamos a entrenar según este programa.",
                "fr": "À partir d'aujourd'hui, on commence l'entraînement en suivant ce programme.",
                "ja": "今日からこの計画に従って訓練を始めるわ。",
                "ko": "오늘부터 이대로 훈련을 시작하자",
                "th": "ตั้งแต่วันนี้เป็นต้นไป เราจะเริ่มฝึกตามหลักสูตรนี้",
                "zh-Hans": "从今天开始，我们按这个计划开始训练。",
                "zh-Hant": "從今天開始，我們按這個計劃開始訓練。"
              },
              "id": 5,
              "speaker": {
                "id": 850215,
                "name": {
                  "zh-Hans": "帕兰卡"
                },
                "entity": {
