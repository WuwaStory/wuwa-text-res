                  }
                }
              }
            },
            {
              "text": {
                "de": "Oh … Jawohl, Coach!",
                "en": "I... Yes, ma'am!",
                "es": "¡Sí!",
                "fr": "Oh... D'accord, Madame !",
                "ja": "こ、これは……はい、コーチ！",
                "ko": "이거... 네, 코치님!",
                "th": "เอ่อ... ครับผม!",
                "zh-Hans": "这……是，教练！",
                "zh-Hant": "這……是，教練！"
              },
