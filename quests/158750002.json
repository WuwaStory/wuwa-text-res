                  }
                }
              }
            },
            {
              "text": {
                "de": "Nein … Ich muss durchhalten!",
                "en": "No... I must resist!",
                "es": "No... ¡Debo aguantar!",
                "fr": "Non... Je dois tenir bon !",
                "ja": "い、いけません……ここは我慢しないと！",
                "ko": "아니에요… 참아야죠",
                "th": "ไม่ได้... ต้องข่มใจเอาไว้!",
                "zh-Hans": "不……要忍耐！",
                "zh-Hant": "不……要忍耐！"
