      "dialogs": [
        {
          "flowId": "剧情_角色生态_卡提希娅",
          "flowIndex": 5,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Hmm … Sind solche Geschichten im Moment beliebt?",
                "en": "Hmm... Is this the kind of story that's popular these days?",
                "es": "Mmm... ¿Este tipo de historia está de moda estos días?",
                "fr": "Hmm... Est-ce que ce genre d'histoire est populaire de nos jours ?",
                "ja": "ふむふむ……今はこういう物語が流行っているのですね。",
                "ko": "음… 요즘엔 이런 이야기가 유행인가?",
                "th": "อืม... สมัยนี้นิยมเรื่องราวประเภทนี้กันเหรอ?",
                "zh-Hans": "唔……现在流行这样的故事吗？",
                "zh-Hant": "唔……現在流行這樣的故事嗎？"
              },
              "id": 1,
              "speaker": {
                "id": 50074,
                "name": {
                  "zh-Hans": "卡提希娅"
                },
                "entity": {
                  "entityId": 158750005,
                  "mapId": 8,
                  "blueprintType": "branch2.0_Player2",
                  "name": "TsEntity_角色034_卡提希娅_角色生态_2_2_常驻2-1",
                  "areaId": 1692,
                  "position": {
                    "x": 703892,
                    "y": 572916,
                    "z": 147
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 68
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Warum gehst du nicht ins Publikum?",
                    "en": "Why not sit with the audience?",
                    "es": "¿Y si nos unimos al público?",
                    "fr": "Pourquoi ne pas rejoindre le public ?",
                    "ja": "{Male=どうして観客席に行かないんだ？;Female=どうして観客席に行かないの？}",
                    "ko": "왜 관객석으로 가지 않으세요?",
                    "th": "ทำไมไม่เข้าไปนั่งกับพวกผู้ชมล่ะ?",
                    "zh-Hans": "为什么不去观众席？",
                    "zh-Hant": "為什麼不去觀眾席？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Aah!",
                "en": "Eek!",
                "es": "¡Aaah!",
                "fr": "Ouaaah !",
                "ja": "あっ！",
                "ko": "어?",
                "th": "ว้าย!",
                "zh-Hans": "诶！",
                "zh-Hant": "欸！"
              },
              "id": 2,
              "speaker": {
                "id": 50074,
                "name": {
                  "zh-Hans": "卡提希娅"
                },
                "entity": {
                  "entityId": 158750005,
                  "mapId": 8,
                  "blueprintType": "branch2.0_Player2",
                  "name": "TsEntity_角色034_卡提希娅_角色生态_2_2_常驻2-1",
                  "areaId": 1692,
                  "position": {
                    "x": 703892,
                    "y": 572916,
                    "z": 147
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 68
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Puh … Du bist es. Einen Moment dachte ich, jemand hätte mich bemerkt.",
                "en": "Phew... It's you. For a second, I thought someone noticed me.",
                "es": "Uf... Eres tú. Por un segundo pensé que alguien me había visto.",
                "fr": "Ouf... C'est toi. Pendant un instant, j'ai cru que quelqu'un m'avait remarqué.",
                "ja": "ああ……あなたでしたか。てっきり気づかれたのかと。",
                "ko": "후우… 당신이었군요, 들킨 줄 알았어요",
                "th": "เฮ้อ... คุณนี่เอง ใจหายหมดเลย นึกว่ามีคนสังเกตเห็นฉันแล้วเสียอีก",
                "zh-Hans": "呼……是你呀，我还以为自己被发现了。",
                "zh-Hant": "呼……是你呀，我還以為自己被發現了。"
              },
              "id": 3,
              "speaker": {
                "id": 50074,
                "name": {
                  "zh-Hans": "卡提希娅"
                },
                "entity": {
                  "entityId": 158750005,
                  "mapId": 8,
                  "blueprintType": "branch2.0_Player2",
                  "name": "TsEntity_角色034_卡提希娅_角色生态_2_2_常驻2-1",
                  "areaId": 1692,
                  "position": {
                    "x": 703892,
                    "y": 572916,
                    "z": 147
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 68
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Bist du sicher, dass du von hier alles hören und sehen kannst?",
                    "en": "Can you really hear and see everything from here?",
                    "es": "¿Seguro que puedes oírlo y verlo todo desde aquí?",
                    "fr": "Et tu peux tout entendre et tout voir d'ici ?",
                    "ja": "{Male=ここからでも、はっきり見えたり聞こえたりするのか？;Female=ここからでも、はっきり見えたり聞こえたりするの？}",
                    "ko": "이 거리에서도 연극이 잘 보여요?",
                    "th": "เธอได้ยินและมองเห็นทุกอย่างจากตรงนี้จริงๆ เหรอ?",
                    "zh-Hans": "在这里真能看清和听清吗？",
                    "zh-Hant": "在這裡真能看清和聽清嗎？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ja … alles gut …",
                "en": "Actually... It's fine...",
                "es": "Sí... está bien...",
                "fr": "En fait... C'est bon...",
                "ja": "はい……全然問題ありません……",
                "ko": "사실… 상관없어요…",
                "th": "ที่จริงก็... ไม่มีปัญหาอะไรหรอก...",
                "zh-Hans": "其实……没问题的……",
                "zh-Hant": "其實……沒問題的……"
              },
              "id": 4,
              "speaker": {
                "id": 50074,
                "name": {
                  "zh-Hans": "卡提希娅"
                },
                "entity": {
                  "entityId": 158750005,
                  "mapId": 8,
                  "blueprintType": "branch2.0_Player2",
                  "name": "TsEntity_角色034_卡提希娅_角色生态_2_2_常驻2-1",
                  "areaId": 1692,
                  "position": {
                    "x": 703892,
                    "y": 572916,
                    "z": 147
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 68
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Dein Tacet-Zeichen leuchtet …",
                    "en": "Your Tacet Mark is glowing...",
                    "es": "Tu marca tácita brilla.",
                    "fr": "Ta Marque taciturne brille...",
                    "ja": "あなたの音痕、光ってる……",
                    "ko": "당신의 성흔이 빛나고 있어요…",
                    "th": "สัญลักษณ์ทาเซ็ตของเธอกำลังเรืองแสง...",
                    "zh-Hans": "你的声痕在亮……",
                    "zh-Hant": "你的聲痕在亮……"
                  }
                },
                {
                  "text": {
                    "de": "Du verwendest doch nicht deine Resonanzfähigkeit, oder?",
                    "en": "You're not using your Forte, are you?",
                    "es": "No estarás usando tu habilidad de Resonancia, ¿verdad?",
                    "fr": "Tu n'utilises pas ta Compétence résonatrice, n'est-ce pas ?",
                    "ja": "{Male=まさか、共鳴能力を使ったのか？;Female=まさか、共鳴能力を使ったの？}",
                    "ko": "이걸 위해 공명 어빌리티를 사용한 건가요?",
                    "th": "เธอไม่ได้กำลังใช้พลังเรโซแนนซ์ใช่ไหม?",
                    "zh-Hans": "你不会专门用了共鸣能力吧？",
                    "zh-Hant": "你不會專門用了共鳴能力吧？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ich bin noch nicht bereit, mich der Öffentlichkeit zu zeigen. Außerdem wurde es dem Publikum in der Vergangenheit erlaubt, sich direkt nach der Aufführung zu einem Stück zu äußern.",
                "en": "I can't exactly reveal myself just yet. Besides, in the past, the audience was never allowed to offer their opinions after a performance...",
                "es": "Aún no estoy preparada para que me vean en público. Además, antes, el público podía opinar sobre una obra justo al acabar la representación.",
                "fr": "Je ne veux pas que le public me voie pour l'instant. De plus, dans le passé, le public était autorisé à exprimer ses commentaires sur une pièce juste après sa représentation.",
                "ja": "姿を見せるわけにはいきませんから……それに以前は演劇が終わった後、観客は感想を述べることができたのです……",
                "ko": "아직 직접 모습을 드러내긴 망설여져서요... 그리고 예전에는 연극이 끝나면 관객들이 소감을 나누곤 했어요",
                "th": "ตอนนี้ฉันยังไม่สามารถเปิดเผยตัวตนได้ นอกจากนั้น เมื่อครั้งอดีต ผู้ชมก็ไม่ได้รับอนุญาตให้แสดงความเห็นหลังจากการแสดงอยู่แล้วด้วย...",
                "zh-Hans": "毕竟我还不好直接现身……而且在以前，戏剧表演结束后，台下观众是可以提出评价的……",
                "zh-Hant": "畢竟我還不好直接現身……而且在以前，戲劇表演結束後，台下觀眾是可以提出評價的……"
              },
              "id": 5,
              "speaker": {
                "id": 50074,
                "name": {
                  "zh-Hans": "卡提希娅"
                },
                "entity": {
                  "entityId": 158750005,
                  "mapId": 8,
                  "blueprintType": "branch2.0_Player2",
                  "name": "TsEntity_角色034_卡提希娅_角色生态_2_2_常驻2-1",
                  "areaId": 1692,
                  "position": {
                    "x": 703892,
                    "y": 572916,
                    "z": 147
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 68
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ich mache mir Sorgen, dass ich mich nicht zurückhalten kann, aufzustehen und … Ich hoffe, du denkst nicht, es liegt daran, dass ich mein Ticket nicht bezahlen kann.",
                "en": "I'm afraid I might not be able to stop myself from standing up... I hope you don't think it's because I can't afford a ticket.",
                "es": "Me preocupa no poder contener la tentación de levantarme de mi asiento y... Pero me siento mal por no haber podido pagar la entrada...",
                "fr": "J'ai peur de ne pas pouvoir résister à l'envie de me lever de mon siège et... J'espère que tu ne crois pas que c'est parce que je ne peux pas payer de billets.",
                "ja": "その時、私が思わず立ち上がってしまわないか心配で……断じて、入場料がないから、というわけではありません。",
                "ko": "그때 제가 참지 못하고 일어날까 봐 걱정돼서요. 뭐, 입장권을 살 돈이 없어서 그런 건 아니에요...",
                "th": "เกรงว่าฉันจะห้ามตัวเองไม่ให้ยืนขึ้นไม่ได้... หวังว่าคุณคงไม่คิดว่านั่นเป็นเพราะฉันไม่มีเงินซื้อตั๋วหรอกนะ",
                "zh-Hans": "我怕到时候我忍不住站起来……总之绝不是因为没钱入场的缘故。",
                "zh-Hant": "我怕到時候我忍不住站起來……總之絕不是因為沒錢入場的緣故。"
              },
              "id": 6,
              "speaker": {
                "id": 50074,
                "name": {
                  "zh-Hans": "卡提希娅"
                },
                "entity": {
                  "entityId": 158750005,
                  "mapId": 8,
                  "blueprintType": "branch2.0_Player2",
                  "name": "TsEntity_角色034_卡提希娅_角色生态_2_2_常驻2-1",
                  "areaId": 1692,
                  "position": {
                    "x": 703892,
