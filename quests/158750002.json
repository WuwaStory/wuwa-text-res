                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 68
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Der Eintritt ist übrigens frei.",
                    "en": "Admissions are free by the way.",
                    "es": "La verdad es que la entrada es gratis.",
                    "fr": "L'entrée est gratuite, en fait.",
                    "ja": "ここは入場無料だよ。",
                    "ko": "여긴 무료 입장이에요",
                    "th": "ยังไงก็เข้าฟรีอยู่แล้วนี่",
                    "zh-Hans": "这里入场是免费的啊。",
                    "zh-Hant": "這裡入場是免費的啊。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Wirklich?!",
                "en": "Really?!",
                "es": "¡¿De veras?!",
                "fr": "Vraiment ?!",
                "ja": "ええ！？",
                "ko": "뭐라고요?",
                "th": "จริงเหรอ?!",
                "zh-Hans": "什么！",
                "zh-Hant": "什麼！"
              },
              "id": 7,
              "speaker": {
