                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Was meinst du?",
                "en": "W-What do you mean?",
                "es": "¿Qué quieres decir?",
                "fr": "Q-Que veux-tu dire ?",
                "ja": "ど、どういう意味だ？",
                "ko": "무, 무슨 뜻이야?",
                "th": "มะ...หมายความว่าไง?",
                "zh-Hans": "什，什么意思？",
                "zh-Hant": "什，什麼意思？"
              },
              "id": 5,
              "speaker": {
                "id": 700315,
                "name": {
                  "zh-Hans": "昂内斯"
