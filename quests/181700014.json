      "dialogs": [
        {
          "flowId": "剧情_3.0星炬学院教学区",
          "flowIndex": 1,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Wer ist da? Halt, stehenbleiben!",
                "en": "Who's there! Stop right there!",
                "es": "¿Quién anda ahí? ¡Detente ahora mismo!",
                "fr": "Qui va là ! Arrêtez-vous !",
                "ja": "誰だ！そこを動くな！",
                "ko": "거기 누구야! 멈춰!",
                "th": "ใครน่ะ! หยุดอยู่ตรงนั้นเลย!",
                "zh-Hans": "什么人！站住！",
                "zh-Hant": "什麼人！站住！"
              },
              "id": 1,
              "speaker": {
                "id": 700324,
                "name": {
                  "zh-Hans": "贝里乌斯"
                },
                "entity": {
                  "entityId": 181700095,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "areaId": 36171,
                  "position": {
                    "x": -49680,
                    "y": -547330,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 20
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ähm, wir … wir sind Studenten …",
                "en": "We're, uh... we're students...",
                "es": "Somos, eh... Somos estudiantes...",
                "fr": "Nous sommes, euh... nous sommes étudiants...",
                "ja": "ここの学生です……",
                "ko": "저희는 학생인데요...",
                "th": "เราเอ่อ... เป็นนักเรียนครับ...",
                "zh-Hans": "我们是学生……",
                "zh-Hant": "我們是學生……"
              },
              "id": 2,
              "speaker": {
                "id": 700316,
                "name": {
                  "zh-Hans": "格奥尔格"
                },
                "entity": {
                  "entityId": 181700092,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "areaId": 36171,
                  "position": {
                    "x": -49500,
                    "y": -547300,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 60
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Studenten? Wer hat euch denn die Erlaubnis gegeben, mitten in der Nacht hier herumzustreunen?",
                "en": "Students? Who gave you permission to be here in the middle of the night?",
                "es": "¿Estudiantes? ¿Y quién os ha dado permiso para estar aquí a estas horas de la noche?",
                "fr": "Des étudiants ? Qui vous a donné la permission d'être ici au beau milieu de la nuit ?",
                "ja": "学生だって？誰がこんな真夜中に、ここへ来ることを許可した？",
                "ko": "학생? 누가 한밤중에 여기 와도 된다고 허락했지?",
                "th": "นักเรียนเหรอ? แล้วใครอนุญาตให้มาอยู่ที่นี่กลางค่ำกลางคืน?",
                "zh-Hans": "学生？谁允许你们大半夜来这里的？",
                "zh-Hant": "學生？誰允許你們大半夜來這裡的？"
              },
              "id": 3,
              "speaker": {
                "id": 700324,
                "name": {
                  "zh-Hans": "贝里乌斯"
                },
                "entity": {
                  "entityId": 181700095,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "areaId": 36171,
                  "position": {
                    "x": -49680,
                    "y": -547330,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 20
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Dann zeigt mir doch mal eure Studentenausweise!",
                "en": "Let me see your student IDs!",
                "es": "¡A ver, vuestras identificaciones!",
                "fr": "Montrez-moi vos cartes d'étudiant !",
                "ja": "学生証を見せて。",
                "ko": "학생증 내놔 봐!",
                "th": "เอาบัตรนักเรียนมาดูซิ!",
                "zh-Hans": "学生证让我看看！",
                "zh-Hant": "學生證讓我看看！"
              },
              "id": 4,
              "speaker": {
                "id": 700324,
                "name": {
                  "zh-Hans": "贝里乌斯"
                },
                "entity": {
                  "entityId": 181700095,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "areaId": 36171,
                  "position": {
                    "x": -49680,
                    "y": -547330,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 20
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Hier, bitte schön …",
                "en": "Here you go, sir. They're all here...",
                "es": "Aquí tiene, señor. Aquí están todas...",
                "fr": "Tenez, monsieur. Les voilà...",
                "ja": "は、はい……",
                "ko": "여, 여기요... 전부 다 있어요...",
                "th": "นี่ครับ อยู่นี่ครับ...",
                "zh-Hans": "这，都在这里……",
                "zh-Hant": "這，都在這裡……"
              },
              "id": 5,
              "speaker": {
                "id": 700317,
                "name": {
                  "zh-Hans": "费兹杰罗"
                },
                "entity": {
                  "entityId": 181700093,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_8",
                  "name": "深夜-费兹杰罗",
                  "areaId": 36171,
                  "position": {
                    "x": -49590,
                    "y": -547280,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "3. Semester Energiewissenschaft? Soso … Was habt ihr hier zu suchen?",
                "en": "A couple of third-years in Energy Sciences, huh? What's your business here?",
                "es": "Conque dos alumnos de tercero de Ciencias de la Energía, ¿eh? ¿Qué pintáis aquí?",
                "fr": "Vous êtes étudiants de troisième année en sciences énergétiques, hein ? Qu'est-ce que vous fichez ici ?",
                "ja": "三年生、エネルギー学部……ここで何をしてたんだ？",
                "ko": "3학년, 에너지 과학부... 너희, 여기서 뭐 하려고?",
                "th": "เด็กแผนกวิทยาศาสตร์พลังงานปีสามสองคนเหรอ? มีธุระอะไรที่นี่ล่ะ?",
                "zh-Hans": "三年级，能源学部……你们来这里干嘛？",
                "zh-Hant": "三年級，能源學部……你們來這裡幹嘛？"
              },
              "id": 6,
              "speaker": {
                "id": 700324,
                "name": {
                  "zh-Hans": "贝里乌斯"
                },
                "entity": {
                  "entityId": 181700095,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "areaId": 36171,
                  "position": {
                    "x": -49680,
                    "y": -547330,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 20
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Wir haben nur nach der Phantomdiva gesucht …",
                "en": "We just wanted to see if we could find the Phantom Diva, sir...",
                "es": "Solo queríamos intentar dar con la diva fantasmagórica, señor...",
                "fr": "On voulait juste voir si on pouvait trouver la Diva Fantôme, monsieur...",
                "ja": "噂の幽霊の歌姫を見つけられないかと思って……",
                "ko": "저희는 그 유령 디바를... 혹시 찾을 수 있나 해서요",
                "th": "เราแค่อยากมาลองตามหาภูตราตรี Diva น่ะครับ...",
                "zh-Hans": "我们只是想看看能不能找到那个幽灵歌姬……",
                "zh-Hant": "我們只是想看看能不能找到那個幽靈歌姬……"
              },
              "id": 7,
              "speaker": {
                "id": 700316,
                "name": {
                  "zh-Hans": "格奥尔格"
                },
                "entity": {
                  "entityId": 181700092,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "areaId": 36171,
                  "position": {
                    "x": -49500,
                    "y": -547300,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 60
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ja! Das Wesen, das aus den Bildschirmen kriecht!",
                "en": "Yeah! The one that crawls out of screens!",
                "es": "¡Sí! ¡Esa que sale de las pantallas!",
                "fr": "Ouais ! Celle qui sort des écrans !",
                "ja": "そう！あのモニターから這い出てくるっていう！",
                "ko": "맞아요! 스크린에서 기어 나온다는 그 사람이요!",
                "th": "ใช่ครับ! ตัวที่คลานออกมาจากจอได้ไงครับ!",
                "zh-Hans": "对！就是那个会从屏幕里爬出来的人！",
                "zh-Hant": "對！就是那個會從螢幕裡爬出來的人！"
              },
              "id": 8,
              "speaker": {
                "id": 700317,
                "name": {
                  "zh-Hans": "费兹杰罗"
                },
                "entity": {
                  "entityId": 181700093,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_8",
                  "name": "深夜-费兹杰罗",
                  "areaId": 36171,
                  "position": {
                    "x": -49590,
                    "y": -547280,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Meint ihr I.R.I.S? Was wollt ihr von ihr?",
                "en": "You mean I.R.I.S.? What do you want with her for?",
                "es": "¿Habláis de IRIS? ¿Para qué la queréis?",
                "fr": "Tu veux parler de S.I.R.E.N.E. ? Qu'est-ce que tu lui veux ?",
                "ja": "I.R.I.S.のことか？彼女に何の用だい？",
                "ko": "I.R.I.S.? 걜 왜 찾는데?",
                "th": "หมายถึง I.R.I.S. น่ะเหรอ? จะเจอไปทำไม?",
                "zh-Hans": "I.R.I.S.？你们找她干嘛？",
                "zh-Hant": "I.R.I.S.？你們找她幹嘛？"
              },
              "id": 9,
              "speaker": {
                "id": 700324,
                "name": {
                  "zh-Hans": "贝里乌斯"
                },
                "entity": {
                  "entityId": 181700095,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_3",
                  "areaId": 36171,
                  "position": {
                    "x": -49680,
                    "y": -547330,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 20
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "I.R.I.S? Das ist unmöglich!",
                "en": "It's I.R.I.S.? That's impossible!",
                "es": "¿IRIS? ¡Imposible!",
                "fr": "C'est S.I.R.E.N.E. ? C'est impossible !",
                "ja": "I.R.I.S.だと？バカな！？",
                "ko": "I.R.I.S.라고요? 설마!?",
                "th": "เป็น I.R.I.S. เองเหรอ? ไม่จริงน่า!",
                "zh-Hans": "是I.R.I.S.？怎么可能！？",
                "zh-Hant": "是I.R.I.S.？怎麼可能！？"
              },
              "id": 10,
              "speaker": {
                "id": 700316,
                "name": {
                  "zh-Hans": "格奥尔格"
                },
                "entity": {
                  "entityId": 181700092,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "areaId": 36171,
                  "position": {
                    "x": -49500,
                    "y": -547300,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 60
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Wer sonst? Ihr seid in einer wissenschaftlichen Einrichtung und nicht an einem Horrorfilm-Set …",
                "en": "Who else would it be? You live in a scientific institute, not some cheap horror flick...",
                "es": "¿Y quién iba a ser si no? Vivís en una institución científica, no en una película de terror de serie B...",
                "fr": "Qui d'autre à ton avis ? Vous vivez dans un institut scientifique, pas dans un film d'horreur de série B...",
                "ja": "他に誰がいるって？ここはどこかの怪談話の世界じゃなく、科学の桃源郷なんだぞ。",
                "ko": "그럼 누구겠니? 여기는 과학 천국이지, 무슨 공포 이야기 세계가 아니라고...",
                "th": "แล้วจะเป็นใครไปได้อีกเล่า? เธออยู่ในสถาบันวิทยาศาสตร์นะ ไม่ใช่ในหนังสยองขวัญเกรดบี...",
                "zh-Hans": "不然呢？你们生活在科学天堂，不是生活在什么恐怖故事世界……",
                "zh-Hant": "不然呢？你們生活在科學天堂，不是生活在什麼恐怖故事世界……"
              },
              "id": 11,
              "speaker": {
                "id": 700324,
                "name": {
                  "zh-Hans": "贝里乌斯"
                },
