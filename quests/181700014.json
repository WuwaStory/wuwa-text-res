                }
              },
              "options": [
                {
                  "text": {
                    "de": "Die Phantomdiva existiert wirklich.",
                    "en": "The Phantom Diva really exists.",
                    "es": "Que la diva fantasmagórica existe de verdad.",
                    "fr": "La Diva Fantôme existe vraiment.",
                    "ja": "{Male=幽霊の歌姫のことだ。;Female=幽霊の歌姫のことよ。}",
                    "ko": "유령 디바는 진짜로 존재해요",
                    "th": "ภูตราตรี Diva น่ะมีอยู่จริง",
                    "zh-Hans": "真的存在幽灵歌姬哦。",
                    "zh-Hant": "真的存在幽靈歌姬哦。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Und mein Onkel ist ein Exoschreiter!",
                "en": "Well, I'll be an Exostrider's uncle!",
                "es": "¡Será posible!",
                "fr": "Eh ben tu parles d'une surprise !",
                "ja": "本当か！",
                "ko": "진짜?",
                "th": "ถ้ามีจริง ฉันก็เป็นตาลุง Exostrider ได้แล้วมั้ง!",
                "zh-Hans": "真的吗！",
                "zh-Hant": "真的嗎！"
              },
              "id": 6,
              "speaker": {
                "id": 700317,
                "name": {
                  "zh-Hans": "费兹杰罗"
                },
                "entity": {
