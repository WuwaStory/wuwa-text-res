      "dialogs": [
        {
          "flowId": "剧情_3.0星炬学院教学区",
          "flowIndex": 1,
          "stateId": 8,
          "talks": [
            {
              "text": {
                "de": "Ist sie wirklich echt? Warum haben wir noch nichts von ihr gesehen?",
                "en": "Is it really real? How come we still haven't seen anything yet?",
                "es": "¿Pero es real? ¿Y cómo es que aún no hemos visto nada?",
                "fr": "Elle existe vraiment ? Comment ça se fait qu'on n'ait encore rien vu ?",
                "ja": "本当にいるのか？なんでまだ見つからないんだ。",
                "ko": "진짜 있다고? 아직도 본 적이 없는데?",
                "th": "ของจริงเหรอเนี่ย? ทำไมเราถึงยังไม่เห็นอะไรเลยล่ะ?",
                "zh-Hans": "真的有么？怎么到现在也还没看到。",
                "zh-Hant": "真的有嗎？怎麼到現在也還沒看到。"
              },
              "id": 1,
              "speaker": {
                "id": 700316,
                "name": {
                  "zh-Hans": "格奥尔格"
                },
                "entity": {
                  "entityId": 181700092,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_4",
                  "areaId": 36171,
                  "position": {
                    "x": -49500,
                    "y": -547300,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 60
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Wonach sucht ihr?",
                    "en": "What are you looking for?",
                    "es": "¿Qué estáis buscando?",
                    "fr": "Qu'est-ce que tu cherches ?",
                    "ja": "{Male=何を探してるんだ？;Female=何を探しているの？}",
                    "ko": "뭘 찾고 있어요?",
                    "th": "หาอะไรอยู่เหรอ?",
                    "zh-Hans": "你们在找什么？",
                    "zh-Hant": "你們在找什麼？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Die Phantomdiva, eines der großen Mysterien der Sternenfackel-Akademie. Es heißt, sie würde nachts aus Bildschirmen kriechen.",
                "en": "The Phantom Diva from Startorch's Great Mysteries. They say she crawls out of screens at night.",
                "es": "A la diva fantasmagórica de los Grandes Misterios de Fuegostelar. Dicen que sale de las pantallas por las noches.",
                "fr": "La Diva Fantôme des Grands mystères de l'académie Brandétoile. On dit qu'elle sort des écrans la nuit.",
                "ja": "学園七不思議の一つ、幽霊の歌姫だよ。モニターから這い出てくるって噂の。",
                "ko": "아카데미의 불가사의 중에 유령 디바가 있는데, 그녀가 화면에서 기어 나온다고 해",
                "th": "หาภูตราตรี Diva จากเรื่องสุดลึกลับแห่งสตาร์ทอร์ชน่ะ เขาว่ากันว่าเธอจะคลานออกมาจากหน้าจอตอนกลางคืน",
                "zh-Hans": "校园不可思议之中的那位幽灵歌姬，据说她会从屏幕里爬出来。",
                "zh-Hant": "校園不可思議之中的那位幽靈歌姬，據說她會從螢幕裡爬出來。"
              },
              "id": 2,
              "speaker": {
                "id": 700317,
                "name": {
                  "zh-Hans": "费兹杰罗"
                },
                "entity": {
                  "entityId": 181700093,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_8",
                  "name": "深夜-费兹杰罗",
                  "areaId": 36171,
                  "position": {
                    "x": -49590,
                    "y": -547280,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Aber wir haben die ganze Nacht gesucht und nichts gefunden.",
                "en": "But we've been searching all night and haven't found anything.",
                "es": "Pero hemos estado buscando toda la noche y no hemos encontrado nada.",
                "fr": "Mais on a cherché toute la nuit et on est toujours bredouilles.",
                "ja": "でも、一晩中探してるのに、なかなか見つからないんだ。",
                "ko": "하지만 밤새도록 찾았는데 아직 찾지 못했어",
                "th": "แต่นี่เราหามาทั้งคืนแล้ว แต่ไม่เจออะไรเลย",
                "zh-Hans": "但是我们找了一晚上了还没找到。",
                "zh-Hant": "但是我們找了一晚上了還沒找到。"
              },
              "id": 3,
              "speaker": {
                "id": 700317,
                "name": {
                  "zh-Hans": "费兹杰罗"
                },
                "entity": {
                  "entityId": 181700093,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_8",
                  "name": "深夜-费兹杰罗",
                  "areaId": 36171,
                  "position": {
                    "x": -49590,
                    "y": -547280,
                    "z": 43210
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 50
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Es gibt sie wirklich.",
                    "en": "She's real, alright.",
                    "es": "Pues es real, sí.",
                    "fr": "Elle est bien réelle.",
                    "ja": "{Male=本当にいるぞ。;Female=本当にいるよ。}",
                    "ko": "진짜예요",
                    "th": "ของจริงแหละ",
                    "zh-Hans": "真的哦。",
                    "zh-Hant": "真的哦。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Was?",
                "en": "Huh?",
                "es": "¿Qué?",
                "fr": "Pardon ?",
                "ja": "え？",
                "ko": "아?",
                "th": "หา?",
                "zh-Hans": "啊？",
                "zh-Hant": "啊？"
              },
              "id": 4,
              "speaker": {
                "id": 700315,
                "name": {
                  "zh-Hans": "昂内斯"
                },
                "entity": {
                  "entityId": 181700097,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_5",
                  "name": "TsEntity_TN_B3_0_拉海洛_MaleM_XS3_5",
                  "areaId": 36171,
