          "talks": [
            {
              "text": {
                "de": "Hm, eine Medaille?",
                "en": "Huh, a medal?",
                "es": "¿Eh? ¿Una medalla?",
                "fr": "Hein, une médaille ?",
                "ja": "あれ？こんなところにメダルが……",
                "ko": "어? 여기에 왜 메달이 있지?",
