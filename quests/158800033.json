                  }
                }
              }
            },
            {
              "text": {
                "de": "In Ordnung, einen Larus-Salat! Sonst noch was?",
                "en": "Okay, one Larus Salad! Anything else?",
                "es": "¡Perfecto, una ensalada de Laurus! ¿Algo más?",
                "fr": "D'accord, une Salade Larus ! Avec ça ?",
                "ja": "ラウルスサラダがお一つですね。他に何かご注文はありますか？",
                "ko": "알겠어 쮸. 푸른 가지 월계 샐러드 하나, 더 필요한 건 없어?",
                "th": "ได้ค่ะ สลัดลอรัสหนึ่งที่! รับอย่างอื่นอีกไหมคะ?",
                "zh-Hans": "好的啾，一份青枝月桂沙拉，还有其他要求嘛？",
                "zh-Hant": "好的啾，一份青枝月桂沙拉，還有其他要求嘛？"
              },
              "id": 2,
              "speaker": {
                "id": 1490,
                "name": {
                  "zh-Hans": "玛格烈特"
                },
                "entity": {
                  "entityId": 314900014,
                  "mapId": 8,
                  "blueprintType": "branch2.0_NPC玛格烈特",
                  "name": "TsEntity_拉古纳_玛格烈特4",
