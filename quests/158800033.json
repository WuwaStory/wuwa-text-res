          "talks": [
            {
              "text": {
                "de": "Hallo, einen Larus-Salat, bitte!",
                "en": "Hello, I'd like a Larus Salad, please!",
                "es": "¡Hola! Me gustaría tomar una ensalada de Laurus, por favor.",
                "fr": "Bonjour, je voudrais une Salade Larus, s'il vous plaît !",
                "ja": "こんにちは。ラウルスサラダを一つ、お願いします！",
                "ko": "안녕하세요, 푸른 가지 월계 샐러드 하나 주세요!",
                "th": "สวัสดี ฉันขอสลัดลอรัสหนึ่งที่นะ!",
                "zh-Hans": "你好，我想要一份青枝月桂沙拉！",
                "zh-Hant": "你好，我想要一份青枝月桂沙拉！"
              },
              "id": 1,
              "speaker": {
                "id": 50074,
                "name": {
                  "zh-Hans": "卡提希娅"
                },
                "entity": {
                  "entityId": 158800632,
                  "mapId": 8,
                  "blueprintType": "branch2.0_Player2",
                  "name": "TsEntity_角色034_卡提希娅_2_7_角色生态_饭店12~13点初见",
