      "tip": {
        "de": "Besiege die verbleibenden TDs",
        "en": "Defeat remaining TDs",
        "es": "Derrota a las DT.",
        "fr": "Vaincre les ennemis",
        "ja": "残像を倒す",
        "ko": "잔상 처치",
        "th": "พิชิตทาเซ็ตดิสคอร์ดที่เหลือ",
        "zh-Hans": "清理残象",
        "zh-Hant": "清理殘象"
      },
      "entities": [
        {
          "entityId": 125000815,
          "mapId": 8,
          "blueprintType": "Gameplay101",
          "name": "发现异常_刷怪器",
          "areaId": 504,
          "position": {
            "x": -46215,
            "y": -13410,
            "z": 19140
          },
          "rotation": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "scale": {
            "x": 100,
            "y": 100,
            "z": 100
          }
        }
      ],
      "dialogs": [
        {
          "flowId": "剧情_角色_忌炎线",
          "flowIndex": 3,
          "stateId": 5,
          "talks": [
            {
              "text": {
                "de": "Es ist der Retroact-Regen ... Wir müssen uns beeilen.",
                "en": "It's the Retroact Rain... We need to hurry up.",
                "es": "Es la Lluvia Retroactiva... Necesitamos apresurarnos.",
                "fr": "C'est la pluie rétroactive... Nous devons nous dépêcher.",
                "ja": "溯洄雨だ……まずい、急ぐぞ。",
                "ko": "「역행비」야... 서두르게, 상황이 안 좋아",
                "th": "นี่มันฝนกลับด้าน... เราต้องรีบแล้ว",
                "zh-Hans": "是溯洄雨……不好，得抓紧时间了。",
                "zh-Hant": "是溯回雨……不好，得抓緊時間了。"
              },
              "id": 1,
              "speaker": {
                "id": 92,
                "name": {
                  "en": "Taoqi",
                  "ja": "桃祈",
                  "zh-Hans": "忌炎"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 123,
      "parentId": 1,
      "type": "ChildQuest",
      "dialogs": [
        {
          "flowId": "剧情_角色_忌炎线",
          "flowIndex": 3,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "... Lass uns ...",
                "en": "...Let's...",
                "es": "...Vamos...",
                "fr": "... Allons...",
                "ja": "……一緒……",
                "ko": "...같이… 시합하러 가자…",
                "th": "...เรามา...",
                "zh-Hans": "我们一起去比赛吧……",
                "zh-Hant": "我們一起去比賽吧……"
              },
              "id": 2,
              "speaker": {
                "id": 690,
                "name": {
                  "zh-Hans": "未知的呓语"
                }
              }
            },
            {
              "text": {
                "de": "Komm ... nicht näher ...",
                "en": "Don't... Come near me...",
                "es": "No... no te acerques...",
                "fr": "Non... Arrête...",
                "ja": "こ……来ないで……",
                "ko": "안돼… 오지 마… 오지 말라고!",
                "th": "อย่า... มาใกล้...",
                "zh-Hans": "别……不要……别过来……",
                "zh-Hant": "別……不要……別過來……"
              },
              "id": 3,
              "speaker": {
                "id": 690,
                "name": {
                  "zh-Hans": "未知的呓语"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Das sieht beängstigend aus.",
                    "en": "That looks scary.",
                    "es": "Eso parece aterrador.",
                    "fr": "Ça a l'air effrayant.",
                    "ja": "ちょっと怖い……",
                    "ko": "좀 무섭긴 한데...",
                    "th": "ดูน่ากลัวนะ",
                    "zh-Hans": "有点吓人……",
                    "zh-Hant": "有點嚇人……"
                  }
                },
                {
                  "text": {
                    "de": "Das sieht bezaubernd aus.",
                    "en": "That looks adorable.",
                    "es": "Eso parece adorable.",
                    "fr": "Ça a l'air adorable.",
                    "ja": "ちょっとかわいい。",
                    "ko": "조금 귀엽네요",
                    "th": "ดูน่ารักดีนะ",
                    "zh-Hans": "有点可爱。",
                    "zh-Hant": "有點可愛。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Die Tacet-Dissonanzen nehmen zu. Lass uns zuerst sie ausschalten.",
                "en": "The Tacet Discords are increasing. Let's take them down first.",
                "es": "Las Disonancias Tácitas están aumentando. Debemos eliminarlas primero.",
                "fr": "Les Tacet Discords rassemblent. Abattons-les d'abord.",
                "ja": "残像が集まってきた、まずはヤツらを倒すぞ。",
                "ko": "잔상이 늘고 있네. 처리해 버리지",
                "th": "ทาเซ็ตดิสคอร์ดกำลังเพิ่มจำนวนขึ้น จัดการพวกมันก่อนเถอะ",
                "zh-Hans": "残象越来越多了，先解决掉它们。",
                "zh-Hant": "殘象越來越多了，先解決掉它們吧。"
              },
              "id": 4,
              "speaker": {
                "id": 92,
                "name": {
                  "en": "Taoqi",
                  "ja": "桃祈",
                  "zh-Hans": "忌炎"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 124,
      "parentId": 1,
      "type": "ChildQuest",
      "dialogs": [
        {
          "flowId": "剧情_角色_忌炎线",
          "flowIndex": 3,
          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "... Lass uns teilnehmen ... Zusammen ...",
                "en": "...Let's participate... Together...",
                "es": "...Vamos a participar... Juntos...",
                "fr": "...Participons... Ensemble...",
                "ja": "……一緒に……参加……",
                "ko": "같이 참가하자!",
                "th": "...มาร่วมกิจกรรม... ด้วยกัน...",
                "zh-Hans": "……我们一起参加吧……",
                "zh-Hant": "……我們一起參加吧……"
              },
              "id": 2,
              "speaker": {
                "id": 690,
                "name": {
                  "zh-Hans": "未知的呓语"
                }
              }
            },
            {
              "text": {
                "de": "Hilfe ... hilf mir ...",
                "en": "Help... help me...",
                "es": "Ayuda... ayúdame...",
                "fr": "Aide... aide-moi...",
                "ja": "た……助けて……",
                "ko": "사... 살려줘...",
                "th": "ช่วย... ช่วยด้วย...",
                "zh-Hans": "救……救救我……",
                "zh-Hant": "救……救救我……"
              },
              "id": 3,
              "speaker": {
                "id": 690,
                "name": {
                  "zh-Hans": "未知的呓语"
                }
              }
            },
            {
              "text": {
                "de": "Die Stimmen kommen von hier.",
                "en": "The voices are coming from here.",
                "es": "Las voces vienen de aquí.",
                "fr": "Les voix viennent d'ici.",
                "ja": "あそこからだ。",
                "ko": "안에서 소리가 들리네",
                "th": "เสียงดังมาจากที่นี่",
                "zh-Hans": "呓语是从这里面传来的。",
                "zh-Hant": "囈語是從這裡面傳來的。"
              },
              "id": 4,
              "speaker": {
                "id": 92,
                "name": {
                  "en": "Taoqi",
                  "ja": "桃祈",
                  "zh-Hans": "忌炎"
                }
              }
            },
            {
              "text": {
                "de": "... Ich will nicht ...",
                "en": "...I don't want...",
                "es": "...No quiero...",
                "fr": "...Non... pas...",
                "ja": "……まだ…死にたく……",
                "ko": "...나는 아직...",
                "th": "...ฉันไม่อยาก...",
                "zh-Hans": "……我还不想……",
                "zh-Hant": "……我還不想……"
              },
              "id": 5,
              "speaker": {
                "id": 690,
                "name": {
                  "zh-Hans": "未知的呓语"
                }
              }
            },
            {
              "text": {
                "de": "Es versucht uns vielleicht etwas zu sagen ... Wir müssen die Nachricht irgendwie entschlüsseln.",
                "en": "It might be trying to tell us something... We need to decipher the message somehow.",
                "es": "Podría estar tratando de decirnos algo... Necesitamos descifrar el mensaje de alguna manera.",
                "fr": "Il essaie peut-être de nous dire quelque chose... Nous devons déchiffrer le message.",
                "ja": "これは…何かを伝えようとしている……",
                "ko": "뭔가를 알려주고 싶어 하는 것 같네. 중요한 정보일 수도 있어",
                "th": "มันอาจจะพยายามบอกอะไรเราอยู่... เราต้องหาทางถอดรหัสข้อความให้ได้",
                "zh-Hans": "这些声音应该是想告诉我们些什么……得解析成有效信息才行。",
                "zh-Hant": "這些聲音應該是想告訴我們些什麼……得解析成有效訊息才行。"
              },
              "id": 6,
              "speaker": {
                "id": 92,
                "name": {
                  "en": "Taoqi",
                  "ja": "桃祈",
                  "zh-Hans": "忌炎"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 126,
      "parentId": 1,
      "type": "ChildQuest",
      "dialogs": [
        {
          "flowId": "剧情_角色_忌炎线",
          "flowIndex": 3,
          "stateId": 3,
          "talks": [
            {
              "text": {
                "de": "Du solltest dich entspannen ... Wochenende ... Wer weiß, wann das nächste ist ... Lass uns gehen ... Komm schon ... Geh ... Übernahme ...",
                "en": "You should relax... Weekend... Who knows when is the next... Let's go... Come on... Go... Takeover...",
