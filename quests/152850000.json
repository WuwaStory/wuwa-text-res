      "dialogs": [
        {
          "flowId": "剧情_七丘_集市生态",
          "flowIndex": 1,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "… Du willst ein Gladiator werden?",
                "en": "...You want to become a Gladiator?",
                "es": "... ¿Quieres convertirte en gladiador?",
                "fr": "... Tu veux devenir gladiateur ?",
                "ja": "……お前がグラディエーターになりたいってのか？",
                "ko": "...검투사가 되고 싶다는 거지?",
                "th": "...อยากเป็นกลาดิเอเตอร์รึ?",
                "zh-Hans": "……就是你想成为角斗士？",
                "zh-Hant": "……就是你想成為角鬥士？"
              },
              "id": 1,
              "speaker": {
                "id": 850146,
                "name": {
                  "zh-Hans": "卡米卢斯"
                },
                "entity": {
                  "entityId": 152850002,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_JDS2_5",
                  "name": "TsEntity_TN_B2_4_七丘_卡米卢斯（一次性）",
                  "areaId": 33104,
                  "position": {
                    "x": 1239961,
                    "y": 1178273,
                    "z": 51295
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 124
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "G-Genau! Kannst du mir bitte verraten, wie man ein erfolgreicher Gladiator wird?",
                "en": "Th-that's right! Please, sir, can you tell me how to become an outstanding Gladiator?",
                "es": "¡S-sí quiero! Por favor, dime cómo puedo convertirme en un gladiador excepcional.",
                "fr": "O... Oui ! S'il vous plaît, monsieur, dites-moi comment devenir un gladiateur d'exception !",
                "ja": "は、はいっ！あの、どうしたら立派なグラディエーターになれるか教えてください！",
                "ko": "네, 맞아요! 선생님, 훌륭한 검투사가 되는 법을 알려주세요!",
                "th": "ชะ ใช่! โปรดบอกทีว่าฉันจะเป็นสุดยอดกลาดิเอเตอร์ได้ยังไง?",
                "zh-Hans": "是、是的！先生，请告诉我怎样才能成为一名优秀的角斗士！",
                "zh-Hant": "是、是的！先生，請告訴我怎樣才能成為一名優秀的角鬥士！"
              },
              "id": 2,
              "speaker": {
                "id": 850206,
                "name": {
                  "zh-Hans": "拉奥"
                },
                "entity": {
                  "entityId": 152850003,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880129",
                  "name": "TsEntity_奥拉（一次性）",
                  "areaId": 33104,
                  "position": {
                    "x": 1239891,
                    "y": 1178391,
                    "z": 51295
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -67
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Hmpf … Wo kommst du denn her?",
                "en": "Hmph... Where you from, kid?",
                "es": "Hmm... ¿De dónde eres, niño?",
                "fr": "Hmpf... D'où viens-tu ?",
                "ja": "ふん……坊主、お前どこから来た？",
                "ko": "흥... 어디서 왔는가?",
                "th": "หืม... เธอมาจากไหนน่ะ เจ้าหนู?",
                "zh-Hans": "哼……小子，你从哪来的？",
                "zh-Hant": "哼……小子，你從哪來的？"
              },
              "id": 3,
              "speaker": {
                "id": 850146,
                "name": {
                  "zh-Hans": "卡米卢斯"
                },
                "entity": {
                  "entityId": 152850002,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_JDS2_5",
                  "name": "TsEntity_TN_B2_4_七丘_卡米卢斯（一次性）",
                  "areaId": 33104,
                  "position": {
                    "x": 1239961,
                    "y": 1178273,
                    "z": 51295
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 124
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "A-Aus Ragunna!",
                "en": "F-from Ragunna!",
                "es": "D-De Raguna.",
                "fr": "D... De Ragunna !",
                "ja": "ぼ、僕はラグーナから来ました！",
                "ko": "라, 라군나에서 왔습니다!",
                "th": "จะ จากรากูนน่า",
                "zh-Hans": "我、我从拉古那来！",
                "zh-Hant": "我、我從拉古那來！"
              },
              "id": 4,
              "speaker": {
                "id": 850206,
                "name": {
                  "zh-Hans": "拉奥"
                },
                "entity": {
                  "entityId": 152850003,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880129",
                  "name": "TsEntity_奥拉（一次性）",
                  "areaId": 33104,
                  "position": {
                    "x": 1239891,
                    "y": 1178391,
                    "z": 51295
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -67
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Also gut, hör mal zu. Wenn du ein erfolgreicher Gladiator werden willst, musst du als Erstes all das hier essen. Los!",
                "en": "Alright, kid, listen up. If you want to be an outstanding Gladiator, the first step is to eat all of this. C'mon!",
                "es": "Está bien, escucha. Si quieres ser un gladiador excepcional, el primer paso es comer todo eso. ¡Vamos!",
                "fr": "Bon, écoute. Si tu veux devenir le meilleur des gladiateurs, tu dois commencer par manger tout ça. Allez !",
                "ja": "いい度胸だ。じゃあ教えてやろう。優れたグラディエーターになる第一歩、それはこれを全部食うことだ、ほらっ！",
                "ko": "좋아, 그럼 말해주지. 훌륭한 검투사가 되려면 첫 번째는 이것들을 먹는 거야. 자!",
                "th": "ฟังนะ เจ้าหนู ถ้าอยากจะเป็นสุดยอดกลาดิเอเตอร์ ขั้นแรกก็ต้องกินนี่ให้หมดเสียก่อน เร็วเข้า!",
                "zh-Hans": "好小子，那我告诉你。要成为一名优秀的角斗士，第一步就是把这些吃下去，来！",
                "zh-Hant": "好小子，那我告訴你。要成為一名優秀的角鬥士，第一步就是把這些吃下去，來！"
              },
              "id": 5,
              "speaker": {
                "id": 850146,
                "name": {
                  "zh-Hans": "卡米卢斯"
                },
                "entity": {
                  "entityId": 152850002,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_JDS2_5",
                  "name": "TsEntity_TN_B2_4_七丘_卡米卢斯（一次性）",
                  "areaId": 33104,
                  "position": {
                    "x": 1239961,
                    "y": 1178273,
                    "z": 51295
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 124
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Das … essen? Aber das ist rohes Fleisch!",
                "en": "Eat... these? But it's raw meat!",
                "es": "¿Comer... esto? ¡Es carne cruda!",
                "fr": "Manger... tout ça ? Mais c'est de la viande crue !",
                "ja": "た、食べ……えっ、これ全部生肉じゃないですか！？",
                "ko": "아니... 이, 이거 다 생고기예요?!",
                "th": "กิน... นี่เหรอ? แต่นี่มันเนื้อดิบนะ",
                "zh-Hans": "吃……这、可这些都是生肉？！",
                "zh-Hant": "吃……這、但這些都是生肉？！"
              },
              "id": 6,
              "speaker": {
                "id": 850206,
                "name": {
                  "zh-Hans": "拉奥"
                },
                "entity": {
                  "entityId": 152850003,
                  "mapId": 8,
                  "blueprintType": "branch2.0_TsEntity_拉古纳平民男4880129",
                  "name": "TsEntity_奥拉（一次性）",
                  "areaId": 33104,
                  "position": {
                    "x": 1239891,
                    "y": 1178391,
                    "z": 51295
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -67
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ganz genau! Wenn du ein großer Gladiator wie ich werden willst, musst du mutig genug sein, rohes Tierfleisch zu essen!",
                "en": "That's right! If you want to be a great Gladiator like me, you need to be brave enough to eat animals raw!",
                "es": "¡Así es! Si quieres ser un gran gladiador como yo, necesitas ser lo suficientemente valiente como para comer animales crudos.",
                "fr": "Eh oui ! Si tu veux devenir un gladiateur de mon rang, tu dois être assez courageux pour manger des animaux crus !",
                "ja": "そうだ！俺みたいに優秀なグラディエーターになりたいなら、まずは生肉を食える度胸が必要だ！",
                "ko": "그래! 나 같은 훌륭한 검투사가 되려면 날것을 먹는 용기부터 가져야 해!",
                "th": "ก็ใช่น่ะสิ ถ้าอยากเป็นสุดยอดกลาดิเอเตอร์แบบฉัน เธอก็ต้องกล้าพอที่จะกินเนื้อสัตว์ดิบๆ",
                "zh-Hans": "对！想要成为像我这样的优秀的角斗士，首先就得有能够茹毛饮血的勇气！",
                "zh-Hant": "對！想要成為像我這樣的優秀的角鬥士，首先就得有能夠茹毛飲血的勇氣！"
              },
              "id": 7,
              "speaker": {
                "id": 850146,
                "name": {
                  "zh-Hans": "卡米卢斯"
                },
                "entity": {
                  "entityId": 152850002,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_MaleM_JDS2_5",
                  "name": "TsEntity_TN_B2_4_七丘_卡米卢斯（一次性）",
                  "areaId": 33104,
                  "position": {
                    "x": 1239961,
                    "y": 1178273,
                    "z": 51295
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 124
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Kann man das w-wirklich essen …? Also gut! Ich esse es!",
                "en": "Is this stuff r-really edible...? Alright, alright! I'll eat it!",
                "es": "¿De v-verdad se puede comer esto...? ¡Está bien! ¡Está bien! Lo comeré.",
                "fr": "C'est v... vraiment comestible ? Bon, d'accord ! Je vais le faire !",
                "ja": "こ、こんなの食べて大丈夫ですか……わ、わかりました！食べます、食べます！",
                "ko": "이, 이거 진짜 먹어도 돼요? 좋, 좋아요... 다 먹을게요!",
                "th": "ของแบบนี้มันกะ กินได้แน่นะ...? ก็ได้ๆ ฉันจะกิน!",
                "zh-Hans": "这、这真的能吃吗……好、好！我吃、我吃！",
                "zh-Hant": "這、這真的能吃嗎……好、好！我吃、我吃！"
              },
              "id": 8,
              "speaker": {
