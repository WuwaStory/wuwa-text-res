                  }
                }
              }
            },
            {
              "text": {
                "de": "…",
                "en": "...",
                "es": "...",
                "fr": "...",
                "ja": "……",
                "ko": "...",
                "th": "...",
                "zh-Hans": "……",
                "zh-Hant": "……"
              },
              "id": 9,
              "speaker": {
                "id": 750088,
                "name": {
                  "zh-Hans": "{PlayerName}"
                }
              }
            },
            {
              "text": {
                "de": "Ist das wirklich essbar …? Ich warte etwas und seh mir das später noch mal an.",
                "en": "Is that really edible...? I'll come back and check later.",
                "es": "¿De verdad se puede comer...? Esperaré un poco y volveré luego.",
                "fr": "Peut-on manger ça...? Je vais attendre un peu et revenir plus tard.",
                "ja": "{Male=これ、本当に食べて大丈夫なのか……少し時間を置いて様子見よう。;Female=これ、本当に食べて大丈夫なのか……少し時間を置いて様子見よう。}",
                "ko": "진짜 먹어도 되는 거라고? 나중에 다시 와봐야겠어",
                "th": "มันกินได้จริงหรอ...? เดี๋ยวค่อยกลับมาใหม่แล้วกัน",
                "zh-Hans": "这真能吃吗……过段时间再来看看情况吧。",
                "zh-Hant": "這真能吃嗎……過段時間再來看看情況吧。"
