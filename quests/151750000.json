  "name": {
    "de": "Überflug der Daten",
    "en": "Data Overdash",
    "es": "Parkour de datos",
    "fr": "Parkour de données",
    "ja": "デジタル天翔け",
    "ko": "데이터 비첨",
    "th": "ข้อมูลพุ่งทะยาน",
    "zh-Hans": "数据飞檐",
    "zh-Hant": "數據飛簷"
  },
  "desc": {
    "de": "Eine Forscherin der Schwarzen Küsten wartet darauf, ihre neuesten Konzepte mit dir zu überprüfen.",
    "en": "The Black Shores' researcher is waiting for you to test out her new ideas.",
    "es": "La investigadora de Costa Negra te está esperando para probar sus nuevas ideas.",
    "fr": "La chercheuse du Littoral noir vous attend pour tester ses nouvelles idées.",
    "ja": "<ano=ブラックショア>黒海岸</ano>の研究員が自分の新発想をあなたと一緒に検証するのを待っている",
    "ko": "검은 해안 연구원은 당신과 함께 본인의 최신 구상을 검증할 것을 기다리고 있어요",
    "th": "นักวิจัยของแบล็กชอร์กำลังรอคุณมาทดสอบไอเดียใหม่ของเธออยู่",
    "zh-Hans": "黑海岸研究员在等待着和你一起验证她的最新构想。",
    "zh-Hant": "黑海岸研究員在等待著和你一起驗證她的最新構想。"
  },
