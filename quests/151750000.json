      "dialogs": [
        {
          "flowId": "剧情_玩法_1.3黑海岸下层跑酷",
          "flowIndex": 2,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Irgendwelche Anmerkungen?",
                "en": "So, any comment?",
                "es": "¿Algún comentario?",
                "fr": "Alors, un commentaire ?",
                "ja": "どうでしたか！",
                "ko": "어때요?",
                "th": "มีความเห็นอะไรไหม?",
                "zh-Hans": "感觉怎么样！",
                "zh-Hant": "感覺怎麼樣！"
              },
              "id": 1,
              "speaker": {
                "id": 1279,
                "name": {
                  "zh-Hans": "研究员"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Nicht schlecht.",
                    "en": "Not bad.",
                    "es": "No está mal.",
                    "fr": "Pas mal.",
                    "ja": "楽しかった。",
                    "ko": "좋네요",
                    "th": "ไม่เลวเลย",
                    "zh-Hans": "还不错。",
                    "zh-Hant": "還不錯。"
                  }
                },
                {
                  "text": {
                    "de": "Warum sind diese Monster hier...",
                    "en": "Why was the monster here...",
                    "es": "¿Por qué están aquí estos monstruos...?",
                    "fr": "Pourquoi ces monstres sont-ils ici...",
                    "ja": "なんで敵が……",
                    "ko": "그 괴물은 왜죠?...",
                    "th": "ทำไมมีมอนสเตอร์ด้วยล่ะ...",
                    "zh-Hans": "怎么还有怪物……",
                    "zh-Hant": "怎麼還有怪物……"
                  }
                },
                {
                  "text": {
                    "de": "Zeit für die Belohnungen!",
                    "en": "Time for the rewards!",
                    "es": "¡Es hora de las recompensas!",
                    "fr": "C'est l'heure des récompenses !",
                    "ja": "{Male=報酬をくれ！;Female=報酬をお願いね！}",
                    "ko": "보상을 줘요!",
                    "th": "ส่งรางวัลมาได้เลย!",
                    "zh-Hans": "奖励拿来！",
                    "zh-Hant": "獎勵拿來！"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Das ist gut zu wissen!",
                "en": "That's good to know!",
                "es": "¡Es bueno saberlo!",
                "fr": "C'est bon à savoir !",
                "ja": "楽しんでもらえて何よりです！",
                "ko": "방랑자가 좋아해서 다행이네요!",
                "th": "พอได้รู้แบบนี้แล้วก็ดีใจจัง!",
                "zh-Hans": "你喜欢就好！",
                "zh-Hant": "你喜歡就好！"
              },
              "id": 2,
              "speaker": {
                "id": 1279,
                "name": {
                  "zh-Hans": "研究员"
                }
              }
            },
            {
              "text": {
                "de": "Und als Nächstes, vielleicht kann ich die Daten als Bausteine verwenden...",
                "en": "And next, maybe I can use the data as building blocks...",
                "es": "Y a continuación, tal vez pueda usar los datos como bloques de construcción...",
                "fr": "Et ensuite, je pourrais utiliser les données comme des blocs de construction...",
                "ja": "次はこのデータで積み木でも積もうか……",
                "ko": "다음 단계에서는 이 데이터를 가지고 블록을 쌓아볼까…",
                "th": "ไม่แน่นะ คราวหน้าฉันอาจจะใช้ข้อมูลเป็นบล็อกก่อสร้างก็ได้...",
                "zh-Hans": "也许下一步用这些数据搭个积木……",
                "zh-Hant": "也許下一步用這些數據搭個積木……"
              },
              "id": 3,
              "speaker": {
                "id": 1279,
                "name": {
                  "zh-Hans": "研究员"
                }
              }
            },
            {
              "text": {
                "de": "Ups! Das ist... Nun, ich habe wohl die falsche Quelldatei verwendet...",
                "en": "Oops! This is... Well, I probably used the wrong source file...",
                "es": "¡Vaya! Esto es... Bueno, probablemente utilicé el archivo de origen incorrecto...",
                "fr": "Oups ! C'est... Eh bien, j'ai probablement utilisé le mauvais fichier comme la source...",
                "ja": "あっ！その……ソースファイルを間違えたのかもしれません……",
                "ko": "아! 이거... 아마 제가 실수로 잘못된 리소스 파일을 사용했나 봐요...",
                "th": "อ้าว! นี่มัน... เอ่อ ฉันอาจจะใช้ไฟล์ต้นทางผิดน่ะ...",
                "zh-Hans": "啊！这个……可能是我不小心用错了源文件……",
                "zh-Hant": "啊！這個……可能是我不小心用錯了原始檔案……"
              },
              "id": 4,
              "speaker": {
                "id": 1279,
                "name": {
                  "zh-Hans": "研究员"
                }
              }
            },
            {
              "text": {
                "de": "Tut mir echt leid! Ich werde nächstes Mal vorsichtiger sein!",
                "en": "So sorry about this! I'll be more cautious next time!",
                "es": "¡Lo siento mucho por esto! ¡Seré más cauteloso la próxima vez!",
                "fr": "Désolé ! Je serai plus prudent la prochaine fois !",
                "ja": "本当にすみません！今度は気を付けますので！",
                "ko": "정말 죄송해요! 다음에는 신경을 더 많이 쓸게요!",
                "th": "ขอโทษจริงๆ นะ! คราวหน้าจะระวังให้มากกว่านี้!",
                "zh-Hans": "真的非常抱歉！我下次会多多注意的！",
                "zh-Hant": "真的非常抱歉！我下次會多多注意的！"
              },
              "id": 5,
              "speaker": {
                "id": 1279,
                "name": {
                  "zh-Hans": "研究员"
                }
              }
            },
            {
              "text": {
                "de": "Natürlich! Die Datensegmente zusammenzusetzen ist wie ein Spiel zu machen! Und ein Spiel hat immer seine Belohnungen!",
                "en": "Of course! Piecing the data segments together is like making a game! And a game always has its rewards!",
                "es": "¡Claro! ¡Unir los segmentos de datos es como hacer un juego! ¡Y un juego siempre tiene sus recompensas!",
                "fr": "Bien sûr ! Assembler les segments de données, c'est comme créer un jeu ! Et un jeu a toujours ses récompenses !",
                "ja": "もちろんです！データを繋ぎ合わせるのって、ゲームを制作しているようなものなので、報酬がなくてはなりません。",
                "ko": "물론이죠! 데이터를 조합하는 게 마치 게임을 만드는 것과 같은데 보상은 빠질 수 없죠",
                "th": "แน่นอน! การปะติดปะต่อข้อมูลแต่ละส่วนเข้าด้วยกันก็เหมือนกับการสร้างเกมนั่นแหละ! และเกมก็มีรางวัลให้เสมอ!",
                "zh-Hans": "当然！把数据拼在一起就像是在制作游戏一样，这怎么能少得了奖励。",
                "zh-Hant": "當然！把數據拼在一起就像是在製作遊戲一樣，這怎麼能少得了獎勵。"
              },
              "id": 6,
              "speaker": {
                "id": 1279,
                "name": {
                  "zh-Hans": "研究员"
                }
              }
            },
            {
              "text": {
                "de": "Danke jedenfalls für deinen Besuch!",
                "en": "Anyway, thanks for dropping by!",
                "es": "De todos modos, ¡gracias por pasar!",
                "fr": "Merci en tout cas de votre visite !",
                "ja": "とにかく、ご参加くださってありがとうございました！",
                "ko": "어쨌든, 와주셔서 감사해요!",
                "th": "ยังไงก็ ขอบคุณที่แวะมานะ!",
                "zh-Hans": "总而言之，谢谢你能来玩！",
                "zh-Hant": "總而言之，謝謝你能來玩！"
              },
              "id": 7,
              "speaker": {
                "id": 1279,
                "name": {
                  "zh-Hans": "研究员"
                }
              }
            }
          ]
        }
      ]
    },
