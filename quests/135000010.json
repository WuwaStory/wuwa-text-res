      "dialogs": [
        {
          "flowId": "剧情_玩法_中曲台地渔村抽奖",
          "flowIndex": 1,
          "stateId": 7,
          "talks": [
            {
              "text": {
                "de": "(Es hält vor einer bestimmten Vorratstruhe an. Ist das die mit dem Hauptpreis?)",
                "en": "(It pauses in front of a particular Supply Chest. Is this the one of the ultimate prize?)",
                "es": "(Se detiene frente a un Cofre de suministros en particular. ¿Es este el del premio máximo?)",
                "fr": "(Il s'est arrêté devant un coffre, est-ce que ce coffre contient le grand prix?)",
                "ja": "（宝箱の前で止まった……大賞の宝箱だろうか？）",
                "ko": "(보물상자 앞에 멈춰 섰어. 설마 이 보물상자가 특별 대상이 담긴 보물상자인 걸까?)",
                "th": "(มันหยุดอยู่ตรงหน้าหีบเสบียงใบหนึ่ง นี่คือหีบเสบียงที่เก็บรางวัลใหญ่สุดไว้หรือเปล่านะ?)",
                "zh-Hans": "（它停在了某个宝箱的面前，难道这个宝箱就是放有大奖的宝箱吗？）",
                "zh-Hant": "（它停在了某個寶箱的面前，難道這個寶箱就是放有大獎的寶箱嗎？）"
              },
              "id": 1,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            },
            {
              "text": {
                "de": "(Ich öffne diese hier!)",
                "en": "(I'll open this one!)",
                "es": "(¡Abriré este!)",
                "fr": "(Ouvrez-le pour voir!)",
                "ja": "（開けてみよう！）",
                "ko": "(우선 열어보자)",
                "th": "(ฉันจะเปิดหีบใบนี้ล่ะ!)",
                "zh-Hans": "（打开试试吧！）",
                "zh-Hant": "（打開試試吧！）"
              },
              "id": 0,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            }
          ]
        }
