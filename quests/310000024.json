      "dialogs": [
        {
          "flowId": "剧情_剧情_吱吱物流",
          "flowIndex": 8,
          "stateId": 3,
          "talks": [
            {
              "text": {
                "de": "Na? Hast du etwas gefunden?",
                "en": "Well? Did you find anything?",
                "es": "¿Y bien? ¿Encontraste algo?",
                "fr": "Alors, qu'est-ce que tu as trouvé ?",
                "ja": "どうです？何か見つかりましたか？",
                "ko": "어때요? 찾은 게 있나요?",
                "th": "เป็นไงบ้าง? เจออะไรบ้างมั้ย?",
                "zh-Hans": "怎么样？找到什么了？",
                "zh-Hant": "怎麼樣？ 找到什麼了？"
              },
              "id": 1,
              "speaker": {
                "id": 741,
                "name": {
                  "zh-Hans": "荣安"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Nichts.",
                    "en": "Nothing.",
                    "es": "Nada.",
                    "fr": "Rien du tout.",
                    "ja": "何もなかった。",
                    "ko": "아무것도 없어요",
                    "th": "ไม่เห็นมีอะไรเลย",
                    "zh-Hans": "什么都没有。",
                    "zh-Hant": "什麼都沒有。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ugh, so viel zu der Aufregung. Ich dachte, ich würde reich werden.",
                "en": "Ugh, so much for the excitement. I thought I was going to get rich.",
                "es": "Ugh, tanto para la emoción. Pensé que iba a enriquecerme.",
                "fr": "Ah... J'étais tout excité pour rien. Je pensais que je pourrais devenir riche du jour au lendemain.",
                "ja": "え……それは残念ですね、一攫千金のチャンスだと思ったのに……",
                "ko": "에휴... 하루아침에 벼락부자가 되는 줄 알고 괜히 들떴네요",
                "th": "เอ๋... ฉันตื่นเต้นเก้อไปคนเดียวงั้นเหรอ คิดว่าจะรวยแล้วซะอีก",
                "zh-Hans": "唉……白激动了，还以为能一夜暴富呢。",
                "zh-Hant": "唉……白激動了，還以為能一夜暴富呢。"
              },
              "id": 0,
              "speaker": {
                "id": 741,
                "name": {
                  "zh-Hans": "荣安"
                }
              }
            }
          ]
