      "dialogs": [
        {
          "flowId": "剧情_剧情_吱吱物流",
          "flowIndex": 8,
          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Es ist nur ein leuchtender Fleck. Es gibt nichts zu finden.",
                "en": "It's just a shiny spot. There is nothing to be found.",
                "es": "Es solo un punto brillante. No hay nada que encontrar.",
                "fr": "C'est juste un point lumineux, il n'y a rien.",
                "ja": "光っているだけで、何もなかった。",
                "ko": "그저 발광점일 뿐, 여기에는 아무것도 없다",
                "th": "ก็แค่แสงธรรมดาๆ ตรงนี้ไม่มีอะไรเลย",
                "zh-Hans": "只是一个发光点，这里什么都没有。",
                "zh-Hant": "只是一個發光點，這裡什麼都沒有。"
              },
              "id": 1,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            }
          ]
        },
        {
          "flowId": "剧情_剧情_吱吱物流",
          "flowIndex": 8,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Ich habe dort drüben etwas leuchten sehen. Könnte es sich um einen versteckten Schatz handeln?",
                "en": "I saw something shining over there. Could it be some kind of hidden treasure?",
                "es": "Vi algo brillante allí. ¿Podría ser algún tipo de tesoro escondido?",
                "fr": "J'ai l'impression qu'il y a quelque chose de brillant là-bas, est-ce qu'il y a un trésor enterré qui est apparu ?",
                "ja": "あそこ、何か光っているように見えました。お宝が埋まっているかもしれません。",
                "ko": "저쪽에 뭔가 밝은 게 있는 것 같아요. 혹시 땅에 묻힌 보물 아닐까요?",
                "th": "ทำไมฉันถึงรู้สึกว่าสิ่งของที่มีแสงเปล่งประกายออกมาตรงนั้น มีสมบัติที่ฝังอยู่โผล่ขึ้นมา?",
                "zh-Hans": "我怎么感觉那边有亮光的东西，是不是有什么埋在地里的宝藏露出来了？",
                "zh-Hant": "我怎麼感覺那邊有亮光的東西，是不是有什麼埋在地裡的寶藏露出來了？"
              },
              "id": 1,
              "speaker": {
                "id": 741,
                "name": {
                  "zh-Hans": "荣安"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Ich schaue mal nach.",
                    "en": "I'll go take a look.",
                    "es": "Voy a echar un vistazo.",
                    "fr": "Je vais confirmer.",
                    "ja": "確かめてくる。",
                    "ko": "제가 가서 살펴볼게요",
                    "th": "ฉันขอไปดูหน่อย",
                    "zh-Hans": "我去看看。",
                    "zh-Hant": "我去看看。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
