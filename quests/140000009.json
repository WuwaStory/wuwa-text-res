      "dialogs": [
        {
          "flowId": "剧情_天城生态_NPC_研究院",
          "flowIndex": 12,
          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Äh... Ähm...",
                "en": "Uh... Umm...",
                "es": "Eh... Umm...",
                "fr": "Oui. ...... ugg......",
                "ja": "ぐ……うぐっ……",
                "ko": "우... 아아...",
                "th": "เอ่อ... อืม...",
                "zh-Hans": "呃……呜唔……",
                "zh-Hant": "呃……嗚唔……"
              },
              "id": 1,
              "speaker": {
                "id": 890,
                "name": {
                  "zh-Hans": "斯奇"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Brauchst du noch etwas?",
                    "en": "Do you need anything else?",
                    "es": "¿Necesitas algo más?",
                    "fr": "Autre chose?",
                    "ja": "まだ叩く？",
                    "ko": "더 필요하세요?",
                    "th": "ต้องการอะไรอีกมั้ย",
                    "zh-Hans": "还需要吗？",
                    "zh-Hant": "還需要嗎？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Genug!! Ich bin jetzt vollkommen wach.",
                "en": "Alright!! Enough! I'm fully awake now!",
                "es": "¡¡Basta!! Ya me he despertado completamente.",
                "fr": "Sto--up !",
                "ja": "スト——ップ！",
                "ko": "아뇨! 이제 그만! 저 완전히 깼어요",
                "th": "เอาล่ะ! พอแล้ว! ฉันตาสว่างแล้ว!",
                "zh-Hans": "行！！够了！我已经完全清醒过来了。",
                "zh-Hant": "行！！夠了！我已經完全清醒過來了。"
              },
              "id": 2,
              "speaker": {
                "id": 890,
                "name": {
                  "zh-Hans": "斯奇"
                }
              }
            },
            {
              "text": {
                "de": "Ich war noch nie so wach, vielen Dank.",
                "en": "I've never felt so awake! Thanks a bunch.",
                "es": "Nunca he estado tan despierto antes, muchas gracias.",
                "fr": "Je suis complètement réveillé maintenant. Merci beaucoup.",
                "ja": "もう完全に目が覚めた。本当にありがとう。",
                "ko": "저 이미 잠 다 깼어요. 정말 고마워요",
                "th": "ฉันไม่เคยรู้สึกตาสว่างแบบนี้มาก่อนเลย! ขอบคุณหลายๆ",
                "zh-Hans": "我已经是前所未有的清醒了，非常感谢你。",
                "zh-Hant": "我已經是前所未有的清醒了，非常感謝你。"
              },
              "id": 3,
              "speaker": {
                "id": 890,
                "name": {
                  "zh-Hans": "斯奇"
                }
              }
            },
            {
              "text": {
                "de": "(Ich sollte besser zurückgehen und mit dem Experiment weitermachen, sonst wache ich in diesem Tempo nie wieder auf.)",
                "en": "(Better hurry back to the lab, or I'll be out like a light if I keep this up.)",
                "es": "(Mejor vuelvo y continúo con el experimento, o no me despertaré de nuevo a este ritmo.)",
                "fr": "(Je continue dès que possible. Si l'on continue, il est très possible que je ne réveille non plus...)",
                "ja": "（早く実験に戻ろう。このままじゃ別の意味で眠らされる……）",
                "ko": "(빨리 돌아가서 실험을 계속해야겠어. 더 맞으면 영원히 잠들 거 같아...)",
                "th": "(ต้องรีบกลับไปที่ห้องแล็บ ไม่อย่างนั้นฉันคงหลับปุ๋ยแน่ถ้าปล่อยไว้แบบนี้)",
                "zh-Hans": "（赶紧回去继续实验，再打下去我估计就再也醒不过来了。）",
                "zh-Hant": "（趕緊回去繼續實驗，再打下去我估計就再也醒不過來了。）"
              },
              "id": 4,
              "speaker": {
                "id": 890,
                "name": {
                  "zh-Hans": "斯奇"
                }
              }
            }
          ]
        }
      ]
