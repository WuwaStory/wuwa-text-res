                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "(Das würde ich mir ansehen.)",
                    "en": "(I'd watch that.)",
                    "es": "(Yo lo vería).",
                    "fr": "(Je regarderais ça.)",
                    "ja": "（{Male=俺も見てみたい。;Female=私も見てみたい。}）",
                    "ko": "(저도 보고 싶어요)",
                    "th": "(ฉันก็อยากดูเหมือนกัน)",
                    "zh-Hans": "（我也想看看。）",
                    "zh-Hant": "（我也想看看。）"
                  }
                },
                {
                  "text": {
                    "de": "Halt, stehenbleiben!",
                    "en": "Stop right there!",
                    "es": "¡Deteneos ahí mismo!",
                    "fr": "Arrête-toi là !",
                    "ja": "{Male=やめるんだ！;Female=やめなさい！}",
                    "ko": "거기 멈춰!",
                    "th": "หยุดนะ!",
                    "zh-Hans": "你们快住手！",
                    "zh-Hant": "你們快住手！"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Verdammt, da kommt jemand. Lauf!",
                "en": "Oh, crap. They've found us. Run for it!",
                "es": "Maldición, viene alguien. ¡Corre!",
                "fr": "Mince, quelqu'un arrive. Cours !",
                "ja": "しまった、早くずらかるぞ！",
                "ko": "제길, 사람이 있어. 도망쳐!",
                "th": "แย่แล้ว มีคนมา หนีเร็ว!",
                "zh-Hans": "糟糕，有人，快跑！",
                "zh-Hant": "糟糕，有人，快跑！"
              },
              "id": 4,
              "speaker": {
                "id": 850144,
                "name": {
                  "zh-Hans": "乌斯"
