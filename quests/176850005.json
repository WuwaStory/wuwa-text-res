            },
            {
              "text": {
                "de": "Hör auf damit. Verschwinden wir!",
                "en": "Cut that out and start running, you idiot!",
                "es": "¡Déjate de juegos y corre!",
                "fr": "Arrête ça. Fiche le camp maintenant !",
                "ja": "いい加減叫ぶのをやめろ。さっさと逃げるぞ。",
                "ko": "그만 소리치고, 빨리 도망가!",
                "th": "เลิกหอนแล้ววิ่งเร็วเข้า เจ้าโง่!",
                "zh-Hans": "别在这嚎了，赶紧跑啊。",
                "zh-Hant": "別在這嚎了，趕緊跑啊。"
