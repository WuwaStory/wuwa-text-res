            },
            {
              "text": {
                "de": "Aaarrgh! Raargh!",
                "en": "AHH—ROAR!",
                "es": "¡Aaarrgh—Raargh!",
                "fr": "Aaarrgh, raargh !",
                "ja": "ゴォォ——ウオォ——！",
                "ko": "우와——오——!",
                "th": "บรู๋วว!",
                "zh-Hans": "呜哇——喔——！",
                "zh-Hant": "嗚哇——喔——！"
              },
