          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Hat er dir geantwortet?",
                "es": "¿Te ha respondido?",
                "zh-Hans": "请问他有回复你吗？",
                "zh-Hant": "請問他有回復你嗎？"
              },
              "id": 1,
              "speaker": {
                "id": 7,
                "name": {
                  "zh-Hans": "朔月"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Wir werden uns in Zukunft nicht mehr sehen.",
                    "es": "No nos veremos en el futuro",
                    "zh-Hans": "以后不再相见",
                    "zh-Hant": "以後不再相見"
                  }
                },
                {
                  "text": {
                    "de": "Ich habe ihn noch nicht gefunden.",
                    "es": "No lo he buscado todavía",
                    "zh-Hans": "还没有找他",
                    "zh-Hant": "還沒有找他"
                  }
                },
                {
                  "text": {
                    "de": "Er wird dich gleich zurückkommen.",
                    "es": "Él volverá a buscarte en un momento",
                    "zh-Hans": "他等下就回来找你",
                    "zh-Hant": "他等下就回來找你"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Wie konnte das passieren... Weh, Weh, Weh.",
                "es": "¿Cómo pudo... suceder esto?",
                "zh-Hans": "怎么会。。。呜呜呜",
                "zh-Hant": "怎麼會。。。 嗚嗚嗚"
              },
              "id": 0,
              "speaker": {
                "id": 7,
                "name": {
                  "zh-Hans": "朔月"
                }
              }
            },
            {
              "text": {
                "de": "Wunderbar, danke dir. Ich muss mich beeilen und zurückgehen, um mich vorzubereiten.",
                "es": "Genial, gracias, tengo que volver a prepararme rápidamente",
                "zh-Hans": "太好了，谢谢你，我得赶紧回去准备了",
                "zh-Hant": "太好了，謝謝你，我得趕緊回去準備了"
              },
              "id": 2,
              "speaker": {
                "id": 7,
                "name": {
                  "zh-Hans": "朔月"
                }
              }
            }
          ]
