      "dialogs": [
        {
          "flowId": "剧情_拉海洛_整流车站系列",
          "flowIndex": 3,
          "stateId": 7,
          "talks": [
            {
              "text": {
                "de": "Alle, die an den Bauarbeiten beteiligt sind, können sich bei mir mit ihrem Pass eine kostenlose Mahlzeit abholen!",
                "en": "Anyone involved in the reconstruction project can come to me with their pass to collect a free meal!",
                "es": "¡Cualquiera que haya participado en el proyecto de reconstrucción puede venir a verme con su pase para conseguir una comida gratis!",
                "fr": "Toute personne participant au projet de reconstruction peut venir me voir avec son laissez-passer pour un repas gratuit !",
                "ja": "再建作業に参加されている方は通行証を見せれば無料で食事が受け取れます！",
                "ko": "재건 프로젝트에 참여하신 분들은 통행증을 가져오시면 무료로 식사를 드려요!",
                "th": "ทุกท่านที่มีส่วนร่วมในโครงการฟื้นฟูสามารถนำบัตรผ่านมารับอาหารฟรีจากฉันได้เลย!",
                "zh-Hans": "参与重建工程的各位可以凭通行证来找我领免费餐点！",
                "zh-Hant": "參與重建工程的各位可以憑通行證來找我領免費餐點！"
              },
              "id": 1,
              "speaker": {
                "id": 700629,
                "name": {
                  "zh-Hans": "马瑟林"
                },
                "entity": {
                  "entityId": 189700858,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_7",
                  "name": "车站3对话1、2-马瑟林（白天）",
                  "areaId": 36109,
                  "position": {
                    "x": 41373,
                    "y": -520227,
                    "z": 34590
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 130
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Ich habe keinen Pass, aber –",
                    "en": "I don't have a pass, but—",
                    "es": "No tengo pase, pero...",
                    "fr": "Je n'ai pas de laissez-passer, mais…",
                    "ja": "通行証は持ってないけど——",
                    "ko": "통행증은 없지만——",
                    "th": "ฉันไม่มีบัตรผ่าน แต่...",
                    "zh-Hans": "我没有通行证但是——",
                    "zh-Hant": "我沒有通行證但是——"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ach, das macht doch nichts! Jeder weiß, wie viel du zum Projekt beigetragen hast.",
                "en": "Ah, don't even worry about it! Everyone knows how much you've helped the project.",
                "es": "¡Ah, no te preocupes por eso! Todo el mundo sabe lo mucho que has ayudado al proyecto.",
                "fr": "Oh, ne vous en faites pas ! On sait tous à quel point vous avez aidé sur le projet.",
                "ja": "いいってことよ。あんたの再建への貢献を知らないやつはいない！",
                "ko": "무슨 말씀을! 재건 프로젝트에 얼마나 공을 세우셨는지 모두 다 알고 있는 걸요!",
                "th": "อ้า ไม่ต้องกังวล! ทุกคนที่นี่รู้ดีว่าคุณมีส่วนช่วยในโปรเจกต์นี้มากขนาดไหน",
                "zh-Hans": "别说啦，你对重建工程的贡献谁不知道！",
                "zh-Hant": "別說啦，你對重建工程的貢獻誰不知道！"
              },
              "id": 2,
              "speaker": {
                "id": 700629,
                "name": {
                  "zh-Hans": "马瑟林"
                },
                "entity": {
                  "entityId": 189700858,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_MaleM_XG_Mid1_7",
                  "name": "车站3对话1、2-马瑟林（白天）",
                  "areaId": 36109,
                  "position": {
                    "x": 41373,
                    "y": -520227,
                    "z": 34590
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 130
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Hier, nimm eins davon. Danke für deine harte Arbeit!",
                "en": "Here, take one of these. Thanks for your hard work!",
                "es": "Toma uno de estos. ¡Gracias por tu duro trabajo!",
                "fr": "Prenez ça. Merci pour tous vos efforts !",
                "ja": "ほら、これを持ってけ。お疲れさま！",
                "ko": "자, 받으세요. 정말 수고하셨어요!",
                "th": "รับไปสิ ขอบคุณที่เหน็ดเหนื่อย!",
                "zh-Hans": "来，拿一份这个，辛苦了！",
                "zh-Hant": "來，拿一份這個，辛苦了！"
              },
