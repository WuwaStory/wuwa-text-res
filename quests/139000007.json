          "talks": [
            {
              "text": {
                "de": "Ich weiß, du bist hier wegen meiner 42300020 Requisiten.",
                "en": "I know, you're here for my 42300020 props.",
                "es": "Sé que estás aquí por mis 42300020 accesorios.",
                "fr": "Je sais et vous êtes venus prendre mon « objet 42300020 ».",
                "ja": "私は知っていて、あなたは私の42300020の道具を奪いに来たのです",
                "ko": "저는 알고 있어요, 당신은 제 42300020 아이템을 빼앗으러 온 거예요",
                "th": "ฉันรู้ คุณมาเพื่อของประกอบฉาก 42300020 ของฉัน",
                "zh-Hans": "我知道，你是来抢我的42300020的道具的",
                "zh-Hant": "我知道，你是來搶我的42300020的道具的"
              },
              "id": 1,
              "speaker": {
                "id": 326,
                "name": {
                  "zh-Hans": "女孩"
                }
              }
            },
            {
              "text": {
                "de": "Ich weiß es schon! Ich gebe es dir jetzt!",
                "en": "I already know! I'll give it to you now!",
                "es": "¡Ya lo sé! ¡Te lo daré ahora!",
                "fr": "Je le sais déjà ! Je vous le donne tout de suite !",
                "ja": "私はもう知っています！今あげるよ！",
                "ko": "이미 알고 있어요! 지금 바로 줄게요!",
                "th": "ฉันรู้อยู่แล้ว! ฉันจะให้คุณเดี๋ยวนี้แหละ!",
                "zh-Hans": "我已经知道了！我现在就给你！",
                "zh-Hant": "我已經知道了！ 我現在就給你！"
              },
              "id": 0,
              "speaker": {
                "id": 326,
                "name": {
                  "zh-Hans": "女孩"
                }
              }
            }
          ]
        }
