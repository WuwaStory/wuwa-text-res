          "talks": [
            {
              "text": {
                "de": "Wenn du Spielzeug kaufen möchtest, musst du zuerst unsere Prüfung bestehen.",
                "es": "Para comprar juguetes, primero debes pasar nuestra prueba",
                "zh-Hans": "要买玩具，要先通过我们的考验",
                "zh-Hant": "要買玩具，要先通過我們的考驗"
              },
              "id": 1,
              "speaker": {
                "id": 37,
                "name": {
                  "zh-Hans": "陌生男性"
                }
              }
            },
            {
              "text": {
                "de": "Hast du die Falle dort drüben gesehen? Du musst sie entschärfen.",
                "es": "¿Ves el mecanismo allí? Necesitas desbloquearlo",
                "zh-Hans": "看到那边的机关了吗，你需要去解开它",
                "zh-Hant": "看到那邊的機關了嗎，你需要去解開它"
              },
              "id": 0,
