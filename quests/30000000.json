      "dialogs": [
        {
          "flowId": "剧情_任务跨副本测试",
          "flowIndex": 9,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Was kann ich für dich tun?",
                "es": "¿Necesitas algo?",
                "zh-Hans": "有什么事么？",
                "zh-Hant": "有什麼事麼？"
              },
              "id": 1,
              "speaker": {
                "id": 37,
                "name": {
                  "zh-Hans": "陌生男性"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Äh, das, das neue Spielzeug, gibt es das?",
                    "es": "¿Tienes ese nuevo juguete?",
                    "zh-Hans": "那个，那个新上的玩具有么",
                    "zh-Hant": "那個，那個新上的玩具有麼"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Oh, du meinst das.",
                "es": "Oh, ¿te refieres a ese?",
                "zh-Hans": "哦，你说那个啊",
                "zh-Hant": "哦，你說那個啊"
              },
              "id": 0,
              "speaker": {
                "id": 37,
                "name": {
                  "zh-Hans": "陌生男性"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Ja, bitte, ich möchte einen Blick darauf werfen.",
                    "es": "Sí, sí, ese, quiero echarle un vistazo.",
                    "zh-Hans": "对对对，那个，我想看一眼",
                    "zh-Hant": "對對對，那個，我想看一眼"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Hier, bitte.",
                "es": "Aquí, es este.",
                "zh-Hans": "喏，就这个",
                "zh-Hant": "喏，就這個"
              },
              "id": 2,
              "speaker": {
                "id": 37,
                "name": {
                  "zh-Hans": "陌生男性"
                }
              }
            },
            {
              "text": {
                "de": "Hast du es im Blick? Wenn du es im Blick hast, dann geh schnell, andere warten noch.",
                "es": "¿Ya lo viste? Si es así, vete rápido, hay gente esperando.",
                "zh-Hans": "看好了么，看好了就快走吧，别人还等着呢",
                "zh-Hant": "看好了麼，看好了就快走吧，別人還等著呢"
              },
              "id": 3,
              "speaker": {
                "id": 37,
                "name": {
                  "zh-Hans": "陌生男性"
                }
              }
            }
          ]
        }
      ]
    },
