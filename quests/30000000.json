      "dialogs": [
        {
          "flowId": "剧情_任务跨副本测试",
          "flowIndex": 10,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Wie sieht es aus? Sag es mir schnell, sag es mir schnell.",
                "es": "¿Cómo es? Dime rápido, dime rápido.",
                "zh-Hans": "是什么样的，快告诉我快告诉我",
                "zh-Hant": "是什麼樣的，快告訴我快告訴我"
              },
              "id": 1,
              "speaker": {
                "id": 335,
                "name": {
                  "zh-Hans": "阿尚"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Nichts Besonderes, nur!%￥@#%￥#@￥……",
                    "es": "No hay nada especial, es solo... ¡%￥@#%￥#@￥...!",
                    "zh-Hans": "也没什么特别的，就是！%￥@#%￥#@￥……",
                    "zh-Hant": "也沒什麼特別的，就是！% ￥@#%￥#@￥……"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Oh, das klingt toll! Kannst du mir bitte eins kaufen? Ich bitte dich.",
                "es": "Uuu, suena genial, ¿puedes comprarme uno, por favor, te lo ruego?",
                "zh-Hans": "呜呜呜，听起来好棒哦，你能帮我买一个来嘛，求求你了",
                "zh-Hant": "嗚嗚嗚，聽起來好棒哦，你能幫我買一個來嘛，求求你了"
              },
              "id": 0,
              "speaker": {
                "id": 335,
                "name": {
                  "zh-Hans": "阿尚"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Nun, das wusste ich schon, dann gut.",
                    "es": "Eh, lo sabía, está bien entonces",
                    "zh-Hans": "额，我就知道，那好吧",
                    "zh-Hant": "額，我就知道，那好吧"
                  }
                },
                {
                  "text": {
                    "de": "Kinder sollten keine unvernünftigen Forderungen stellen.",
                    "es": "Los niños no deben hacer demandas irracionales",
                    "zh-Hans": "小朋友不能提无理的要求哦",
                    "zh-Hant": "小朋友不能提無理的要求哦"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ich bitte dich, ich bitte dich, guter Mensch.",
                "es": "Te lo ruego, te lo ruego, buena persona",
                "zh-Hans": "求求你了求求你了，好心人",
                "zh-Hant": "求求你了求求你了，好心人"
              },
              "id": 2,
              "speaker": {
                "id": 335,
                "name": {
                  "zh-Hans": "阿尚"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Nun, dann gut.",
                    "es": "Eh, está bien entonces",
                    "zh-Hans": "额，那好吧",
                    "zh-Hant": "額，那好吧"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
