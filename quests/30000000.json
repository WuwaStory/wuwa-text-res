      "dialogs": [
        {
          "flowId": "剧情_任务跨副本测试",
          "flowIndex": 8,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Willkommen im Wunderladen, womit kann ich dir helfen?",
                "es": "Bienvenido a la tienda maravillosa, ¿en qué puedo ayudarte?",
                "zh-Hans": "欢迎光临奇妙商店，有什么我能帮助你的嘛？",
                "zh-Hant": "歡迎光臨奇妙商店，有什麼我能幫助你的嘛？"
              },
              "id": 1,
              "speaker": {
                "id": 36,
                "name": {
                  "zh-Hans": "陌生女性"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Habe gehört, es gibt ein neues Spielzeug im Sortiment?",
                    "es": "¿Oí que hay un nuevo juguete en la tienda?",
                    "zh-Hans": "听说最近有款新玩具上架？",
                    "zh-Hant": "聽說最近有款新玩具上架？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Oh, du meinst das.",
                "es": "Oh, ¿te refieres a ese?",
                "zh-Hans": "哦，你说那个呀",
                "zh-Hant": "哦，你說那個呀"
              },
              "id": 0,
              "speaker": {
                "id": 36,
                "name": {
                  "zh-Hans": "陌生女性"
                }
              }
            },
            {
              "text": {
                "de": "Das ist kein ständiges Produkt in unserem Laden, du solltest den mysteriösen Händler dort drüben fragen.",
                "es": "Eso no es un producto regular en nuestra tienda, deberías preguntarle al comerciante misterioso de allí.",
                "zh-Hans": "那不是本店的常驻商品，你要找那边的神秘商人询问一下哦",
                "zh-Hant": "那不是本店的常駐商品，你要找那邊的神秘商人詢問一下哦"
              },
              "id": 2,
              "speaker": {
                "id": 36,
                "name": {
                  "zh-Hans": "陌生女性"
                }
              }
            }
          ]
        }
      ]
    },
