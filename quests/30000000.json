      "dialogs": [
        {
          "flowId": "剧情_任务跨副本测试",
          "flowIndex": 3,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Eins, zwei, drei, vier, fünf.",
                "es": "Uno, dos, tres, cuatro, cinco.",
                "zh-Hans": "一二三四五",
                "zh-Hant": "一二三四五"
              },
              "id": 1,
              "speaker": {
                "id": 36,
                "name": {
                  "zh-Hans": "陌生女性"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Was meinst du damit?",
                    "es": "¿Qué significa?",
                    "zh-Hans": "什么意思",
                    "zh-Hant": "什麼意思"
                  }
                },
                {
                  "text": {
                    "de": "(Ist dieser Mensch nicht seltsam?)",
                    "es": "(¿Esta persona tiene un problema?)",
                    "zh-Hans": "（这人是不是有问题）",
                    "zh-Hant": "（這人是不是有問題）"
                  }
                },
                {
                  "text": {
                    "de": "Geh und besiege den Tiger auf dem Berg!",
                    "es": "¡Subir la montaña para cazar al tigre!",
                    "zh-Hans": "上山打老虎！",
                    "zh-Hant": "上山打老虎！"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "(Die Frau zuckt mit den Schultern und antwortet nicht.)",
                "es": "(La mujer se encoge de hombros, no responde)",
                "zh-Hans": "（女人耸耸肩，没有回应）",
                "zh-Hant": "（女人聳聳肩，沒有回應）"
              },
              "id": 0,
              "speaker": {
                "id": 36,
                "name": {
                  "zh-Hans": "陌生女性"
                }
              }
            },
            {
              "text": {
                "de": "In Ordnung, du hast das Codewort richtig.",
                "es": "De acuerdo, has dado la contraseña",
                "zh-Hans": "可以，你对上了暗号",
                "zh-Hant": "可以，你對上了暗號"
              },
              "id": 2,
              "speaker": {
                "id": 36,
                "name": {
                  "zh-Hans": "陌生女性"
                }
              }
            },
            {
              "text": {
                "de": "Du musst dich noch vorbereiten, wenn du bereit bist, dann komm zu mir und geh in den wunderbaren Laden.",
                "es": "Deberías prepararte un poco, cuando estés listo, ven a buscarme para entrar a la tienda maravillosa.",
                "zh-Hans": "你还要做一下准备吧，准备好了就再来找我进入奇妙商店哦",
                "zh-Hant": "你還要做一下準備吧，準備好了就再來找我進入奇妙商店哦"
              },
              "id": 3,
              "speaker": {
                "id": 36,
                "name": {
                  "zh-Hans": "陌生女性"
                }
              }
            }
          ]
        },
        {
          "flowId": "剧情_任务跨副本测试",
          "flowIndex": 7,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "(Der Mann ignoriert dich.)",
                "es": "(El hombre no te presta atención)",
                "zh-Hans": "（男人并不理你）",
                "zh-Hant": "（男人並不理你）"
              },
              "id": 1,
              "speaker": {
                "id": 37,
                "name": {
                  "zh-Hans": "陌生男性"
                }
              }
            }
          ]
        }
      ]
