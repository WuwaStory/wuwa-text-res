      "dialogs": [
        {
          "flowId": "剧情_3.0拉海洛_学院散点bvb",
          "flowIndex": 1,
          "stateId": 3,
          "talks": [
            {
              "text": {
                "de": "Duellieren ist immer noch mein liebster Zeitvertreib!",
                "en": "Dueling is still the best pastime ever!",
                "es": "¡Los duelos siguen siendo lo más divertido del mundo!",
                "fr": "Les duels sont le meilleur passe-temps de tous les temps !",
                "ja": "やっぱり、やっぱりデュエルが一番楽しい！",
                "ko": "역시, 결투가 제일 재밌다니까!",
                "th": "เห็นไหมล่ะ การดวลนี่แหละสนุกที่สุดแล้ว!",
                "zh-Hans": "果然，还是决斗最有意思了！",
                "zh-Hant": "果然，還是決鬥最有意思了！"
              },
              "id": 1,
              "speaker": {
                "id": 700795,
                "name": {
                  "zh-Hans": "激昂的决斗家"
                },
                "entity": {
                  "entityId": 320701086,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS1_10",
                  "name": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS1_10",
                  "areaId": 36170,
                  "position": {
                    "x": -68615,
                    "y": -548720,
                    "z": 36245
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": 20
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Danke, {PlayerName}. Jetzt, wo ich wieder voller Energie bin, kann ich meinen Einkaufsbummel fortsetzen!",
                "en": "Thank you, {PlayerName}. Now that I'm energized, I can continue my shopping trip!",
                "es": "Gracias, {PlayerName}. Ahora que estoy llena de energía, ¡puedo seguir con mis compras!",
                "fr": "Merci, {PlayerName}. Je suis pleine d'énergie, je peux continuer ma virée shopping !",
                "ja": "ありがとう、{PlayerName}。すっごく気分がすっきりした。ショッピングを続けられそうだよ！",
                "ko": "고마워, {PlayerName}. 이제 속이 다 시원해져서 계속 쇼핑할 수 있겠어!",
                "th": "ขอบคุณมากนะ {PlayerName} ตอนนี้ฉันรู้สึกกระปรี้กระเปร่าขึ้นแล้ว ไปช้อปปิ้งต่อได้แล้วแหละ!",
                "zh-Hans": "谢谢你，{PlayerName}。我现在感觉神清气爽，又可以继续逛街了！",
                "zh-Hant": "謝謝你，{PlayerName}。我現在感覺神清氣爽，又可以繼續逛街了！"
              },
              "id": 2,
              "speaker": {
                "id": 700795,
                "name": {
                  "zh-Hans": "激昂的决斗家"
                },
                "entity": {
                  "entityId": 320701086,
                  "mapId": 906,
                  "blueprintType": "TsEntity_TN_B3_0_拉海洛_FemaleM_XS1_10",
