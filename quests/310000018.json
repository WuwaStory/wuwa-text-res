      "dialogs": [
        {
          "flowId": "剧情_剧情_吱吱物流",
          "flowIndex": 3,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Ich habe jemanden gesehen, der zu etwas aufschaute, also wurde ich neugierig und schaute hoch...",
                "en": "I saw someone staring up at something, so I got curious and looked up...",
                "es": "Vi a alguien mirando algo, así que me puse curioso y miré hacia arriba...",
                "fr": "Il y a un moment, il y avait quelqu'un qui regardait quelque chose, je l'ai regardé un moment...",
                "ja": "さっきここで何かを見上げている人がいたから、つい俺も一緒に見ちゃって……",
                "ko": "아까 어떤 사람이 여기서 고개를 들고 무언가를 보고 있길래 저도 따라봤거든요...",
                "th": "เมื่อกี้มีคนเงยหน้าขึ้นไปมองอะไรก็ไม่รู้ ฉันก็เลยลองทำตาม...",
                "zh-Hans": "刚才有个人在这抬着头不知道在看什么，我就跟着看了一会儿……",
                "zh-Hant": "剛才有個人在這抬著頭不知道在看什麼，我就跟著看了一會兒……"
              },
              "id": 2,
              "speaker": {
                "id": 739,
                "name": {
                  "zh-Hans": "阿澄"
                }
              }
            },
            {
              "text": {
                "de": "Als ich mich umdrehte, stellte ich fest, dass alle Pakete, die ich ausliefere, von diesen verdammten Echsen weggeschnappt worden waren!",
                "en": "When I turned around, I realized that all the packages I'm delivering had been snatch away by those damn lizards!",
                "es": "Cuando me di la vuelta, me di cuenta de que todos los paquetes que estoy entregando habían sido arrebatados por esos malditos lagartos!",
                "fr": "Je me suis retourné et j'ai vu que ma marchandise a été emportée par le Lézard lavique !",
                "ja": "気づいたら、荷物を熔解トカゲに奪われてしまってたんだ！",
                "ko": "그 사이에 화석화 카멜레온이 제 물건을 물고 갔어요!",
                "th": "แต่พอหันมาสินค้าก็ถูกเจ้ากิ้งก่าพวกนั้นคาบไปซะแล้ว!",
                "zh-Hans": "一转身发现我的货被火蜥蜴叼走了！",
                "zh-Hant": "一轉身發現我的貨被火蜥蜴叼走了！"
              },
              "id": 1,
              "speaker": {
                "id": 739,
                "name": {
                  "zh-Hans": "阿澄"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "...",
                    "en": "...",
                    "es": "...",
                    "fr": "...",
                    "ja": "……",
                    "ko": "……",
                    "th": "...",
                    "zh-Hans": "……",
                    "zh-Hant": "……"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Glaubst du, wir können uns an sie heranschleichen und meine Pakete zurückholen?",
                "en": "Do you think we can sneak up on them and get my packages back?",
                "es": "¿Crees que podemos acercarnos a ellos y recuperar mis paquetes?",
                "fr": "Penses-tu que nous pourrions récupérer la marchandise sans être remarqué ?",
                "ja": "背後からこっそりと荷物を取り戻せたりしないかな？",
                "ko": "저희가 몰래 그들의 뒤를 따라가 물건을 되찾아 올 수 있다고 생각하나요?",
                "th": "คุณคิดว่าเราจะแอบไปเอาสินค้ากลับมาได้มั้ย?",
                "zh-Hans": "你觉得我们能悄悄地从它们背后把货拿回来吗？",
                "zh-Hant": "你覺得我們能悄悄地從它們背後把貨拿回來嗎？"
              },
              "id": 0,
              "speaker": {
                "id": 739,
                "name": {
                  "zh-Hans": "阿澄"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Überlass das mir.",
                    "en": "Leave it to me.",
                    "es": "Déjamelo a mí.",
                    "fr": "Je m'en occupe.",
                    "ja": "任せて。",
                    "ko": "제게 맡겨주세요",
                    "th": "เดี๋ยวฉันจัดการเอง",
                    "zh-Hans": "交给我吧。",
                    "zh-Hant": "交給我吧。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
