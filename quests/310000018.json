      "dialogs": [
        {
          "flowId": "剧情_剧情_吱吱物流",
          "flowIndex": 3,
          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Das waren echt coole Moves! Wow!",
                "en": "Those were some really cool moves! Wow!",
                "es": "¡Esos fueron algunos movimientos realmente geniales! ¡Guau!",
                "fr": "La façon dont tu as fait ça tout à l'heure était vraiment cool ! Comme ça... - Aa !",
                "ja": "今の技かっこよかったな！こう……は！さっ！って。",
                "ko": "방금 그 수법 정말 멋졌어요! 이렇게... 쓱... 하...",
                "th": "เมื่อกี้คุณต่อสู้ได้เจ๋งมาก! ฮึบ... ฮ่า... ย่าห์...",
                "zh-Hans": "你刚才那招可真帅啊！就像这样…唰…哈……",
                "zh-Hant": "你剛才那招可真帥啊！ 就像這樣…唰…哈……"
              },
              "id": 1,
              "speaker": {
                "id": 739,
                "name": {
                  "zh-Hans": "阿澄"
                }
              }
            },
            {
              "text": {
                "de": "Ach ja, danke, dass du mir geholfen hast, meine Pakete zurückzubekommen!",
                "en": "Oh right, thank you for helping me get my packages back!",
                "es": "¡Ah, cierto, gracias por ayudarme a recuperar mis paquetes!",
                "fr": "D'ailleurs, merci de m'avoir aidé à récupérer mes marchandises !",
                "ja": "荷物のことも本当にありがとう！",
                "ko": "참, 물건을 찾아줘서 고마워요!",
                "th": "ขอบคุณนะที่ช่วยฉันเอาสินค้ากลับมา!",
                "zh-Hans": "对了，谢谢你帮我拿回货！",
                "zh-Hant": "對了，謝謝你幫我拿回貨！"
              },
              "id": 0,
              "speaker": {
                "id": 739,
                "name": {
                  "zh-Hans": "阿澄"
                }
              }
            }
          ]
        }
