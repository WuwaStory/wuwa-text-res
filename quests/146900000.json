      "dialogs": [
        {
          "flowId": "剧情_1_1_世界_乘宵山_7天拔剑",
          "flowIndex": 1,
          "stateId": 10,
          "talks": [
            {
              "text": {
                "de": "Gibt es schon wieder einen Kampf? Ernsthaft?",
                "en": "Is there another fight? Seriously?",
                "es": "¿Otro combate? ¿En serio?",
                "fr": "Y a-t-il un autre combat ? Sérieusement ?",
                "ja": "まさか、他の場所の残像ともケンカをしようとしてるなんてことは……。",
                "ko": "설마 또 다른 잔상을 찾아서 싸우려는 건 아니겠지...",
                "th": "ยังมีสู้กันอีกเหรอ? เอาจริงดิ?",
                "zh-Hans": "它不会还要去找其他残象打架吧……",
                "zh-Hant": "它不會還要去找其他殘象打架吧……"
              },
              "id": 1,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            }
          ]
        },
        {
          "flowId": "剧情_1_1_世界_乘宵山_7天拔剑",
          "flowIndex": 1,
          "stateId": 8,
          "talks": [
            {
              "text": {
                "de": "Also führst du mich hin, um deinem Freund zu helfen? Hätte nicht erwartet, dass es Kameradschaft unter den Hoartoises gibt.",
                "en": "So you're leading me to help your friend? Didn't expect camaraderie among Hoartoises.",
                "es": "¿Así que me estás guiando para ayudar a tu amiga? No esperaba camaradería entre las Escartugas.",
                "fr": "Alors tu m'emmènes aider ton ami ? Je ne m'attendais pas à une camaraderie parmi les Torturoids.",
                "ja": "なるほど、ここまで連れてきたのは仲間を助けてほしいみたいだ。寒霜亀ってなかなか義理堅いのかも。",
                "ko": "친구를 구해 달라는 거였어? 거북이끼리도 이렇게 의리가 있는 줄은 몰랐네",
                "th": "นี่แกพาฉันมาช่วยเพื่อนของแกเหรอ? ไม่คิดเลยว่าพวกเต่าน้ำค้างแข็งจะมีมิตรภาพสนิทสนมกันขนาดนี้",
                "zh-Hans": "原来是想让我来救你的同伴吗？没想到陆龟之间这么讲义气。",
                "zh-Hant": "原來是想讓我來救你的同伴嗎？ 沒想到陸龜之間這麼講義氣。"
              },
              "id": 1,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            }
          ]
        }
      ]
    },
