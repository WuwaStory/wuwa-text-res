      "dialogs": [
        {
          "flowId": "剧情_1_1_世界_乘宵山_7天拔剑",
          "flowIndex": 1,
          "stateId": 9,
          "talks": [
            {
              "text": {
                "de": "Ist das wunderbare Instrument in diesem drin?",
                "en": "The miraculous instrument is inside of this?",
                "es": "¿El instrumento milagroso está dentro de esto?",
                "fr": "L'instrument miraculeux est à l'intérieur de ça ?",
                "ja": "奇跡をもたらす不思議な楽器はこの中に？",
                "ko": "이 안에 들어있는 게 기적을 가져다주는 악기인 건가?",
                "th": "มีเครื่องดนตรีมหัศจรรย์อยู่ข้างในนี้เหรอ?",
                "zh-Hans": "这里面就是带来奇迹的乐器吗？",
                "zh-Hant": "這裡面就是帶來奇跡的樂器嗎？"
              },
              "id": 1,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            },
            {
              "text": {
                "de": "Die Hoartoises tanzen wirklich... Unglaublich.",
                "en": "The Hoartoises really are dancing... Incredible.",
                "es": "Las Escartugas están bailando de verdad. ¡Es increíble!",
                "fr": "Les Torturoids dansent vraiment... Incroyable.",
                "ja": "すごい……寒霜亀たちが本当に踊りだした。",
                "ko": "대단해... 거북이들이 정말 춤을 추기 시작했어",
                "th": "เต่าน้ำค้างแข็งพวกนี้เต้นอยู่จริงๆ ด้วย... เหลือเชื่อจริงๆ",
                "zh-Hans": "好厉害……陆龟们真的跳起舞来了。",
                "zh-Hant": "好厲害……陸龜們真的跳起舞來了。"
              },
              "id": 2,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            }
          ]
        }
      ]
