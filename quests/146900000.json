        "en": "Catch up with the Hoartoise",
        "es": "Alcanza a la Escartuga.",
        "fr": "Rattrapez le Torturoid",
        "ja": "亀に付いて行く",
        "ko": "땅거북 따라가기",
        "th": "ตามเต่าน้ำค้างแข็งไปให้ทัน",
        "zh-Hans": "跟上陆龟",
        "zh-Hant": "跟上陸龜"
      },
