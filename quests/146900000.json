    },
    {
      "id": 18,
      "parentId": 12,
      "type": "ChildQuest",
      "dialogs": [
        {
          "flowId": "剧情_1_1_世界_乘宵山_7天拔剑",
          "flowIndex": 1,
          "stateId": 14,
          "talks": [
            {
              "text": {
                "de": "Diese Hoartoise wird von anderen Tacet-Dissonanzen bedrängt... Sieht so aus, als bräuchte sie wirklich Hilfe.",
                "en": "This Hoartoise is getting mobbed by other Tacet Discords... Looks like it really needs help.",
                "es": "Unas Disonancias Tácitas están acosando a esta Escartuga... ¡Parece que necesita ayuda!",
                "fr": "Ce Torturoid est submergé par d'autres TDs... Il semble vraiment avoir besoin d'aide.",
                "ja": "あの寒霜亀、他の残像に囲まれてる……助けてあげないと。",
                "ko": "잔상들이 거북이를 에워싼 채 공격하고 있어... 거북이를 도와줘야 할 것 같아",
                "th": "เต่าน้ำค้างแข็งตัวนี้กำลังโดนทาเซ็ตดิสคอร์ดตัวอื่นๆ รุม... ดูเหมือนว่ามันจะต้องการความช่วยเหลือจริงๆ นะ",
                "zh-Hans": "这只陆龟在被其他残象围攻……它好像很需要帮助。",
                "zh-Hant": "這隻陸龜在被其他殘象圍攻……它好像很需要幫助。"
              },
              "id": 1,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            }
          ]
        }
      ]
    },
