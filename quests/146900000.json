      "dialogs": [
        {
          "flowId": "剧情_1_1_世界_乘宵山_7天拔剑",
          "flowIndex": 1,
          "stateId": 6,
          "talks": [
            {
              "text": {
                "de": "Es scheint, als wolle es mich irgendwohin führen. Ich sollte ihm folgen und sehen, was dort vor sich geht.",
                "en": "Seems like it wants to take me somewhere. I should follow it and see what's going on there.",
                "es": "Parece que quiere dirigirme a algún lugar. Debería seguirla y ver qué está pasando allí.",
                "fr": "Il semble vouloir m'emmener quelque part. Je devrais le suivre et voir ce qui se passe là-bas.",
                "ja": "どこかに連れて行ってくれるみたいだ。ついて行ってみよう。",
                "ko": "날 어딘가로 데려가려는 것 같은데 일단 따라가 보자",
                "th": "ดูเหมือนว่ามันอยากจะพาฉันไปที่ไหนสักแห่ง ฉันควรตามมันไปดูว่าเกิดอะไรขึ้นที่นั่น",
                "zh-Hans": "它好像要带我去什么地方，跟上去看看吧。",
                "zh-Hant": "它好像要帶我去什麼地方，跟上去看看吧。"
              },
              "id": 1,
              "speaker": {
                "id": 83,
                "name": {
                  "zh-Hans": "Speaker_83_Name"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 16,
