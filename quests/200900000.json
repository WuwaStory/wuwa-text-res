      "dialogs": [
        {
          "flowId": "剧情_V1.1Bossrush活动",
          "flowIndex": 1,
          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Die Lufttemperatur ist angenehm, und die Luftfeuchtigkeit ist...",
                "en": "Temperature favorable. Humidity is...",
                "es": "La temperatura es favorable, y el nivel de humedad...",
                "fr": "Température favorable. Humidité est...",
                "ja": "温度は快適、湿度は……。",
                "ko": "공기 온도는 적당하고, 습도는...",
                "th": "อุณหภูมิเหมาะสม ความชื้นก็...",
                "zh-Hans": "空气温度适宜，湿度在……",
                "zh-Hant": "空氣溫度適宜，濕度在……"
              },
              "id": 1,
              "speaker": {
                "id": 952,
                "name": {
                  "zh-Hans": "青恭"
                },
                "entity": {
                  "entityId": 11000460,
                  "mapId": 8,
                  "blueprintType": "NPC0260",
                  "name": "TsEntity_0260_157_青恭",
                  "areaId": 301,
                  "position": {
                    "x": -50399,
                    "y": 103963,
                    "z": 1392
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -46
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Über das Forschungsprojekt der Akademie...",
                    "en": "About the Academy's research project...",
                    "es": "Sobre el proyecto de investigación de la Academia...",
                    "fr": "Au sujet du projet de recherche de l'Académie...",
                    "ja": "研究院の実験について……。",
                    "ko": "연구원의 실험 프로젝트에 대해선...",
                    "th": "เกี่ยวกับโครงการวิจัยของสถาบัน...",
                    "zh-Hans": "关于研究院的实验项目……",
                    "zh-Hant": "關於研究院的實驗專案……"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Oh, du bist es. Hast du schon unsere neueste Technologie ausprobiert?",
                "en": "Oh, it's you. Have you tried testing our latest technology?",
                "es": "Ah, eres tú. ¿Ya has probado nuestra última tecnología?",
                "fr": "Oh, c'est vous. Avez-vous essayé notre dernière technologie ?",
                "ja": "やあ、来ていたんだな。実験のテストには参加してみたか？",
                "ko": "음? 어서 와요! 실험 프로젝트의 테스트에 참가하러 갔었나요?",
                "th": "โอ้ คุณน่ะเอง คุณลองทดสอบเทคโนโลยีล่าสุดของเราแล้วหรือยัง?",
                "zh-Hans": "哦，是你啊？你去参加实验项目的测试了吗？",
                "zh-Hant": "哦，是你啊？ 你去參加實驗專案的測試了嗎？"
              },
              "id": 2,
              "speaker": {
                "id": 952,
                "name": {
                  "zh-Hans": "青恭"
                },
                "entity": {
                  "entityId": 11000460,
                  "mapId": 8,
                  "blueprintType": "NPC0260",
                  "name": "TsEntity_0260_157_青恭",
                  "areaId": 301,
                  "position": {
                    "x": -50399,
                    "y": 103963,
                    "z": 1392
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -46
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Ja, das habe ich.",
                    "en": "Yes, I have.",
                    "es": "Sí.",
                    "fr": "Oui, je l'ai fait.",
                    "ja": "参加した。",
                    "ko": "이미 했어요",
                    "th": "ใช่ ลองมาแล้ว",
                    "zh-Hans": "参加了。",
                    "zh-Hant": "參加了。"
                  }
                },
                {
                  "text": {
                    "de": "Noch nicht.",
                    "en": "Not yet.",
                    "es": "Aún no.",
                    "fr": "Pas encore.",
                    "ja": "まだ。",
                    "ko": "아직이요",
                    "th": "ยังเลย",
                    "zh-Hans": "还没有。",
                    "zh-Hant": "還沒有。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Mit deiner Hilfe habe ich Vertrauen darin, dass unsere Technologie bald ihr volles Potenzial für unsere Soldaten erreichen wird.",
                "en": "With your assistance, I have faith that our technology will soon reach its full potential for our soldiers to utilize.",
                "es": "Con tu ayuda, tengo fe de que nuestra tecnología estará lista pronto y permitirá que nuestros soldados alcancen su máximo potencial.",
                "fr": "Avec votre aide, j'ai foi en ce que notre technologie atteindra bientôt son plein potentiel pour nos soldats.",
                "ja": "あなたの協力があれば、きっと「投影」技術もすぐに戦士たちの日々の訓練に取り入れられるはずだ。",
                "ko": "당신이 도와준 덕분에 이 기술도 곧 전사들의 일상 훈련에 도입될 수 있을 거예요",
                "th": "ด้วยความช่วยเหลือของคุณ ฉันเชื่อว่าเทคโนโลยีของเราจะสามารถบรรลุศักยภาพสูงสุด พร้อมให้ทหารของเราได้ใช้งานในเร็วๆ นี้",
                "zh-Hans": "有了你的帮助，相信这项技术可以更快地运用到战士们的日常训练中去。",
                "zh-Hant": "有了你的幫助，相信這項科技可以更快地運用到戰士們的日常訓練中去。"
              },
              "id": 3,
              "speaker": {
                "id": 952,
                "name": {
                  "zh-Hans": "青恭"
                },
                "entity": {
                  "entityId": 11000460,
                  "mapId": 8,
                  "blueprintType": "NPC0260",
                  "name": "TsEntity_0260_157_青恭",
                  "areaId": 301,
                  "position": {
                    "x": -50399,
                    "y": 103963,
                    "z": 1392
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -46
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Denk dran, es irgendwann mal anzuschauen! Ich habe dich bereits angemeldet.",
                "en": "Remember to go check it out at some point, then! I've already signed up for you.",
                "es": "¡Recuerda ir a probarla cuando puedas! Ya te he apuntado.",
                "fr": "N'oubliez pas d'y jeter un œil à un moment donné, alors ! Je vous ai déjà inscrit.",
                "ja": "プロジェクトのテスト人員としてあなたの名前で申請はしてあるから、忘れずに頼むよ。",
                "ko": "잊지 마세요! 프로젝트 내부에 참가 등록을 신청해 놨어요",
                "th": "ถ้างั้นก็อย่าลืมไปลองดูสักครั้งนะ! ฉันสมัครให้คุณเรียบร้อยแล้ว",
                "zh-Hans": "可不要忘了哦，我已经跟项目内部帮你报名了。",
                "zh-Hant": "可不要忘了喔，我已經幫你報名了。"
              },
              "id": 4,
              "speaker": {
                "id": 952,
                "name": {
                  "zh-Hans": "青恭"
                },
                "entity": {
                  "entityId": 11000460,
                  "mapId": 8,
                  "blueprintType": "NPC0260",
                  "name": "TsEntity_0260_157_青恭",
                  "areaId": 301,
                  "position": {
                    "x": -50399,
                    "y": 103963,
                    "z": 1392
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -46
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Dein Gesichtsausdruck sagt mir, dass du etwas fragen möchtest.",
                "en": "The look on your face tells me you've got something to ask.",
                "es": "Tu expresión me dice que tienes alguna pregunta.",
                "fr": "Votre visage me dit que vous avez quelque chose à demander.",
                "ja": "その表情を見る限り、俺に何か聞きたいことでもあるみたいだな。",
                "ko": "제게 묻고 싶은 게 있는 표정 같은데요?",
                "th": "สีหน้าของคุณบ่งบอกว่ามีเรื่องอยากจะถาม",
                "zh-Hans": "看你的表情，是不是有事情想要问我？",
                "zh-Hant": "看你的表情，是不是有事情想要問我？"
              },
              "id": 5,
              "speaker": {
                "id": 952,
                "name": {
                  "zh-Hans": "青恭"
                },
                "entity": {
                  "entityId": 11000460,
                  "mapId": 8,
                  "blueprintType": "NPC0260",
                  "name": "TsEntity_0260_157_青恭",
                  "areaId": 301,
                  "position": {
                    "x": -50399,
                    "y": 103963,
                    "z": 1392
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -46
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Wie hast du von diesem Forschungsprojekt erfahren?",
                    "en": "How did you learn about this research project?",
                    "es": "¿Cómo te enteraste de este proyecto de investigación?",
                    "fr": "Comment as-tu entendu parler de ce projet de recherche ?",
                    "ja": "研究院のプロジェクトを知っていたのはなぜ？",
                    "ko": "연구원의 프로젝트는 어떻게 알게 된 거죠?",
                    "th": "คุณรู้เกี่ยวกับโครงการวิจัยนี้ได้ยังไง?",
                    "zh-Hans": "你怎么知道研究院的项目？",
                    "zh-Hant": "你怎麼知道研究院的專案？"
                  }
                },
                {
                  "text": {
                    "de": "Bist du wirklich ein Forscher?",
                    "en": "Are you really a researcher?",
                    "es": "¿De verdad eres un investigador?",
                    "fr": "Es-tu vraiment un chercheur ?",
                    "ja": "あなたは研究員……？",
                    "ko": "연구원이 맞나요?",
                    "th": "คุณเป็นนักวิจัยจริงๆ เหรอ?",
                    "zh-Hans": "你是不是一个研究员？",
                    "zh-Hant": "你是不是一個研究員？"
                  }
                },
                {
                  "text": {
                    "de": "Warum trägst du keinen Labormantel wie die anderen Forscher?",
                    "en": "Why are you not wearing a lab coat like the other researchers?",
                    "es": "¿Por qué no llevas una bata de laboratorio como los demás investigadores?",
                    "fr": "Pourquoi ne portes-tu pas une blouse de laboratoire comme les autres chercheurs ?",
                    "ja": "白衣を着ていないのはなぜ？",
                    "ko": "어째서 흰 가운을 안 입고 있는 거죠?",
                    "th": "ทำไมคุณไม่ใส่ชุดแล็บเหมือนนักวิจัยคนอื่นล่ะ?",
                    "zh-Hans": "你为什么不穿白大褂？",
                    "zh-Hant": "你為什麼不穿白大褂？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Du hast scharfe Augen. Wie ich erwartet habe.",
                "en": "You have keen eyes. As I expected.",
                "es": "No se te escapa una... Como esperaba.",
                "fr": "Tu as l'œil vif. Comme je m'y attendais.",
                "ja": "思った通り、あなたは細かいところまでよく見ているな。",
                "ko": "꽤 날카로운걸요. 역시 제 안목은 정확하다니까요",
                "th": "คุณมีสายตาที่เฉียบแหลม อย่างที่ฉันคิดไว้เลย",
                "zh-Hans": "我看人的眼光果然没错，你很细心啊。",
                "zh-Hant": "我看人的眼光果然沒錯，你很細心啊。"
              },
              "id": 6,
              "speaker": {
                "id": 952,
                "name": {
                  "zh-Hans": "青恭"
                },
                "entity": {
                  "entityId": 11000460,
                  "mapId": 8,
