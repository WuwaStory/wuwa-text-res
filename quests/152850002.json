      "dialogs": [
        {
          "flowId": "剧情_七丘_集市生态",
          "flowIndex": 5,
          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Hey! Du da! Tritt unserem Team bei!",
                "en": "Hey! You there! Come form a team with us!",
                "es": "¡Oye, tú! ¡Ven y forma un equipo con nosotros!",
                "fr": "Hé ! Toi ! Viens former une équipe avec nous !",
                "ja": "ヘイ！ヨー！{Male=お兄ちゃん;Female=お姉ちゃん}、一緒にチームを組もうよ！",
                "ko": "에이! 요! {Male=형;Female=누나}, 우리 팀 합류해줘요~!",
                "th": "นี่ๆ! มาร่วมทีมกับเราสิ",
                "zh-Hans": "嘿！哟！{Male=哥哥;Female=姐姐}，快和我们一起组成战队吧！",
                "zh-Hant": "嘿！喲！{Male=哥哥;Female=姐姐}，快和我們一起組成戰隊吧！"
              },
              "id": 1,
              "speaker": {
                "id": 850152,
                "name": {
                  "zh-Hans": "认真的男孩"
                },
                "entity": {
                  "entityId": 152850014,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleS_Boy5_1",
                  "name": "TsEntity_TN_B2_4_七丘_认真的男孩",
                  "areaId": 33104,
                  "position": {
                    "x": 1245132,
                    "y": 1180481,
                    "z": 50814
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -80
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Lass uns zusammen ein Team bilden!",
                "en": "Form a team! Form a team!",
                "es": "¡Forma un equipo! ¡Forma un equipo!",
                "fr": "Oui ! Former une équipe !",
                "ja": "組もう！組もう！",
                "ko": "맞아요! 같이 해줘요!",
                "th": "ร่วมทีมกัน! ร่วมทีมกัน!",
                "zh-Hans": "组成战队！组成战队！",
                "zh-Hant": "組成戰隊！組成戰隊！"
              },
              "id": 2,
              "speaker": {
                "id": 850153,
                "name": {
                  "zh-Hans": "开心的女孩"
                },
                "entity": {
                  "entityId": 152850015,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleS_Girl5_1",
                  "name": "TsEntity_TN_B2_4_七丘_开心的女孩",
                  "areaId": 33104,
                  "position": {
                    "x": 1245062,
                    "y": 1180441,
                    "z": 50814
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -60
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Na gut. Wie heißt das Team?",
                    "en": "Alright. What's the team's name?",
                    "es": "Está bien. ¿Cuál es el nombre del equipo?",
                    "fr": "D'accord. Quel est notre nom d'équipe ?",
                    "ja": "いいよ。チーム名は何にする？",
                    "ko": "좋아요, 팀 이름이 뭐예요?",
                    "th": "ก็ได้ ชื่อทีมอะไรเหรอ?",
                    "zh-Hans": "好啊，战队名叫什么？",
                    "zh-Hant": "好啊，戰隊名叫什麼？"
                  }
                },
                {
                  "text": {
                    "de": "Ich finde, euer Team sieht doch schon ganz gut aus.",
                    "en": "I think your team looks just fine.",
                    "es": "Creo que tu equipo está bien así.",
                    "fr": "Votre équipe est bien comme elle est.",
                    "ja": "あなたたちが組めばいい。",
                    "ko": "전 그저 지켜보기만 할게요",
                    "th": "ฉันว่าทีมของเธอเข้าทีแล้วนะ",
                    "zh-Hans": "我看你们组就好。",
                    "zh-Hant": "我看你們組就好。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Jaaa! Dann nennen wir uns die Super-Champs von morgen!",
                "en": "Yay! Then let's call ourselves the Super Future Champs!",
                "es": "¡Síí! ¡Llamémonos Los Futuros Supercampeones!",
                "fr": "Ouais ! On s'appellera les Super futurs champions !",
                "ja": "やった！じゃあ、俺たちのチームは未来のスーパーチャンピオンって名前にする！",
                "ko": "아싸! 그럼 팀 이름은 슈퍼 미래의 챔피언으로 할래요!",
                "th": "เย่! งั้นตั้งชื่อว่าทีมเราว่าสุดยอดว่าที่ผู้คว้าชัยกันเถอะ!",
                "zh-Hans": "好耶！那我们就叫超级未来冠军！",
                "zh-Hant": "好耶！那我們就叫超級未來冠軍！"
              },
              "id": 3,
              "speaker": {
                "id": 850152,
                "name": {
                  "zh-Hans": "认真的男孩"
                },
                "entity": {
                  "entityId": 152850014,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleS_Boy5_1",
                  "name": "TsEntity_TN_B2_4_七丘_认真的男孩",
                  "areaId": 33104,
                  "position": {
                    "x": 1245132,
                    "y": 1180481,
                    "z": 50814
                  },
                  "rotation": {
                    "x": 0,
                    "y": 0,
                    "z": -80
                  },
                  "scale": {
                    "x": 100,
                    "y": 100,
                    "z": 100
                  }
                }
              }
            },
            {
              "text": {
                "de": "Ach ja? … Also gut! Dann pass gut auf! Wir sind … die Super-Champs von morgen!",
                "en": "Is that so? ...Alright! Then you just watch! We are... the Super Future Champs!",
                "es": "¿Es verdad...? ¡Está bien! Entonces observa. Nosotros somos... ¡Los Futuros Supercampeones!",
                "fr": "Ah oui ? D'accord ! Eh bien, regarde ! On est... les Super futurs champions !",
                "ja": "そっか……よし！じゃあ見ててね！俺たちは、未来のスーパーチャンピオンだ！",
                "ko": "알겠어요... 그럼 잘 지켜봐 주세요! 우리는 슈퍼 미래의 챔피언 팀이야!",
                "th": "เหรอ?...ก็ได้ งั้นดูนะ พวกเราคือ... สุดยอดว่าที่ผู้คว้าชัย!",
                "zh-Hans": "这样呀……好！那你看好啦！我们是，超级未来冠军！",
                "zh-Hant": "這樣呀……好！那你看好啦！我們是，超級未來冠軍！"
              },
