        {
          "flowId": "剧情_七丘_集市生态",
          "flowIndex": 5,
          "stateId": 3,
          "talks": [
            {
              "text": {
                "de": "Also gut, Kinder. Bedanken wir uns bei {Male=diesem netten jungen Mann;Female=dieser netten jungen Dame} …",
                "en": "Alright, children. Let's say thank you to this nice {Male=young man;Female=young lady}...",
                "es": "Está bien, niños. Démosle las gracias a {Male=este amable señor;Female=esta amable señorita}...",
                "fr": "Allez, les enfants. Dites merci à {Male=ce gentil monsieur;Female=cette gentille dame}...",
                "ja": "さあ、みんな、この{Male=お兄ちゃん;Female=お姉ちゃん}にお礼を言おうね――",
                "ko": "자, 얘들아, 얼른 고맙다고 인사하세요",
                "th": "เอาล่ะ เด็กๆ มาขอบคุณ{Male=พ่อหนุ่ม;Female=แม่สาว}ใจดีคนนี้กันเถอะ...",
                "zh-Hans": "好了孩子们，让我们谢谢这位{Male=哥哥;Female=姐姐}——",
                "zh-Hant": "好了孩子們，讓我們謝謝這位{Male=哥哥;Female=姐姐}——"
              },
              "id": 1,
              "speaker": {
                "id": 850319,
                "name": {
                  "zh-Hans": "温柔的老师"
                },
                "entity": {
                  "entityId": 152850017,
                  "mapId": 8,
                  "blueprintType": "TsEntity_TN_B2_4_七丘_FemaleM11_6",
