                  }
                }
              }
            },
            {
              "text": {
                "de": "Dankeschön …",
                "en": "Thank you, {Male=Mister;Female=Miss}...",
                "es": "Gracias, {Male=señor;Female=señorita}...",
                "fr": "Merci, {Male=monsieur;Female=madame}...",
                "ja": "ありがとう、{Male=お兄ちゃん;Female=お姉ちゃん}――",
                "ko": "고맙습니다, {Male=오빠;Female=언니}~",
                "th": "ขอบคุณค่ะ {Male=พี่ชาย;Female=พี่สาว}...",
