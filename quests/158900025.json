      "dialogs": [
        {
          "flowId": "剧情_2_0_每日_玛格烈特今日套餐",
          "flowIndex": 5,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Willkommen! Was darf es sein?",
                "en": "Welcome! What can I get for you?",
                "es": "¡{Male=Bienvenido;Female=Bienvenida}! ¿Qué puedo ofrecerte?",
                "fr": "Bienvenue ! Que puis-je vous servir ?",
                "ja": "いらっしゃいませ、今日は何になさいますか？",
                "ko": "왔어? 오늘은 어떤 걸 먹고 싶어?",
                "th": "ยินดีต้อนรับ! รับอะไรดีคะ?",
                "zh-Hans": "您来了，今天想要点些什么？",
                "zh-Hant": "您來了，今天想要點些什麼？"
              },
              "id": 1,
              "speaker": {
                "id": 50173,
                "name": {
                  "zh-Hans": "莱丽娅"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Ich habe Hunger.",
                    "en": "I'm hungry.",
                    "es": "Tengo hambre.",
                    "fr": "J'ai faim.",
                    "ja": "お腹すいた。",
                    "ko": "배고파요",
                    "th": "ฉันหิว",
                    "zh-Hans": "我饿了。",
                    "zh-Hant": "我餓了。"
                  }
                },
                {
                  "text": {
                    "de": "Ich bin wegen des kostenlosen Gerichts hier.",
                    "en": "I'm here for the free food.",
                    "es": "Estoy aquí por la comida gratis.",
                    "fr": "La nourriture gratuite m'appelle.",
                    "ja": "奢られに来た。",
                    "ko": "공짜로 먹을 수 있을까요?",
                    "th": "ฉันมากินอาหารฟรี",
                    "zh-Hans": "来蹭饭了。",
                    "zh-Hant": "來白吃白喝了。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Heute gibt es ein Kombimenü nur für {PlayerName} – natürlich aufs Haus! Was darf es heute denn sein?",
                "en": "Today we're serving the {PlayerName}-exclusive combo set—on the house! What are you feeling like today?",
                "es": "¡Hoy servimos el combo exclusivo de {PlayerName}, por cuenta de la casa! ¿Qué te pide el cuerpo?",
                "fr": "Aujourd'hui, nous avons le combo exclusif pour {PlayerName}, c'est la maison qui régale ! Qu'est-ce qui vous tente ?",
                "ja": "今日はちょうど、{PlayerName}様専用無料セットがあるんです！今日の味の気分を教えてください。",
                "ko": "오늘 마침 {PlayerName} 전용 공짜 세트가 있거든! 어떤 걸 먹고 싶어?",
                "th": "วันนี้มีชุดอาหารพิเศษสำหรับ {PlayerName} โดยเฉพาะด้วย! คุณอยากทานรสแบบไหนคะ?",
                "zh-Hans": "今天正好有一份{PlayerName}专属免费套餐！想吃什么口味的？",
                "zh-Hant": "今天正好有一份{PlayerName}專屬免費套餐！想吃什麼口味的？"
              },
              "id": 2,
              "speaker": {
                "id": 50173,
                "name": {
                  "zh-Hans": "莱丽娅"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Süß.",
                    "en": "Sweet.",
                    "es": "Dulce.",
                    "fr": "Sucré.",
                    "ja": "甘いのが食べたい。",
                    "ko": "달콤한 게 당기네요",
                    "th": "หวาน",
                    "zh-Hans": "想吃甜的。",
                    "zh-Hant": "想吃甜的。"
                  }
                },
                {
                  "text": {
                    "de": "Salzig.",
                    "en": "Salty.",
                    "es": "Salado.",
                    "fr": "Salé.",
                    "ja": "しょっぱいのが食べたい。",
                    "ko": "짠 게 당기네요",
                    "th": "เค็ม",
                    "zh-Hans": "想吃咸的。",
                    "zh-Hant": "想吃鹹的。"
                  }
                },
                {
                  "text": {
                    "de": "Scharf.",
                    "en": "Spicy.",
                    "es": "Picante.",
                    "fr": "Épicé.",
                    "ja": "辛いのが食べたい。",
                    "ko": "매운 게 당기네요",
                    "th": "เผ็ด",
                    "zh-Hans": "想吃辣的。",
                    "zh-Hant": "想吃辣的。"
                  }
                },
                {
                  "text": {
                    "de": "Ich nehme das heutige Tagesgericht.",
                    "en": "I'll have today's special.",
                    "es": "Hoy me tomaré el especial del día.",
                    "fr": "Je prendrai le plat du jour.",
                    "ja": "今日のオススメをください。",
                    "ko": "추천해 주세요",
                    "th": "ฉันเอาเมนูพิเศษประจำวันนี้",
                    "zh-Hans": "来一份今日推荐。",
                    "zh-Hant": "來一份今日推薦。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Nach wenigen Minuten genießt du das Essen, das Lelia für dich gekocht hat.",
                "en": "After a brief wait, you enjoy the meal Lelia prepared.",
                "es": "Después de una breve espera, disfrutas de la comida que preparó Lelia.",
                "fr": "Après une courte attente, vous appréciez le repas préparé par Lelia.",
                "ja": "リーリアの料理を堪能した。",
                "ko": "잠시 후, 라일리아가 만든 요리를 맛있게 먹었다",
                "th": "หลังจากรอครู่หนึ่ง คุณก็ได้ลิ้มลองอาหารที่ Lelia ทำ",
                "zh-Hans": "你稍作等待后，畅快地享用了女孩烹饪的菜肴。",
                "zh-Hant": "你稍作等待後，暢快地享用了女孩烹飪的菜餚。"
              },
              "id": 3
            },
            {
              "text": {
                "de": "Schmeckt dir das Essen?",
                "en": "Are you satisfied with your meal?",
                "es": "¿Estás {Male=satisfecho;Female=satisfecha} con la comida?",
                "fr": "Comment trouvez-vous le plat ?",
                "ja": "お口に合いましたか？",
                "ko": "오늘 음식은 입맛에 맞았어?",
                "th": "อาหารถูกใจมั้ยคะ?",
                "zh-Hans": "今天的菜品还合您的口味吗？",
                "zh-Hant": "今天的菜品還合您的口味嗎？"
              },
              "id": 4,
              "speaker": {
                "id": 50173,
                "name": {
                  "zh-Hans": "莱丽娅"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Du erhältst eine 5-Sternewertung von mir.",
                    "en": "You get a five-star rating from me.",
                    "es": "Te pongo cinco estrellas.",
                    "fr": "Tu obtiens une note de cinq étoiles de ma part.",
                    "ja": "高評価せざるを得ない。",
                    "ko": "아주 맛있었어요",
                    "th": "ฉันให้ห้าดาวเลยละ",
                    "zh-Hans": "给你好评。",
                    "zh-Hant": "給你好評。"
                  }
                },
                {
                  "text": {
                    "de": "Ja und es würde mir nichts ausmachen, jeden Tag ein kostenloses Gericht zu bekommen.",
                    "en": "Yes, and I wouldn't mind having a free meal every day.",
                    "es": "Sí, y no me importaría disfrutar de esta comida gratis todos los días.",
                    "fr": "Très bien, je ne suis pas contre recevoir un repas gratuit tous les jours.",
                    "ja": "良かった。それと毎日無料セットがあると嬉しい。",
                    "ko": "맛있었어요, 매일 공짜 세트가 있었으면 좋겠네요",
                    "th": "ชอบสิ ถ้าได้กินฟรีทุกวันเลยยิ่งดี",
                    "zh-Hans": "还行，希望天天有免费套餐。",
                    "zh-Hant": "還行，希望天天有免費套餐。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Schön, dass es dir schmeckt.",
                "en": "I'm glad you like it.",
                "es": "Me alegro de que te guste.",
                "fr": "Je suis contente que ça vous plaise.",
                "ja": "ご満足いただけたようで何よりです。",
                "ko": "맛있게 먹었으면 됐어",
                "th": "ดีใจจังที่คุณชอบ",
                "zh-Hans": "嗯，您吃得开心就好。",
                "zh-Hant": "嗯，您吃得開心就好。"
              },
              "id": 5,
              "speaker": {
                "id": 50173,
                "name": {
                  "zh-Hans": "莱丽娅"
                }
              }
            },
            {
              "text": {
                "de": "Mal sehen, was ich arrangieren kann!",
                "en": "I'll see what I can do!",
                "es": "¡Veré qué puedo hacer!",
                "fr": "Je vais voir ce que je peux faire !",
                "ja": "はい……よりお口に合う料理を作れるよう、頑張ります！",
                "ko": "그건... 노력해 볼게!",
                "th": "ฉันจะลองดูนะว่าทำอะไรได้!",
                "zh-Hans": "这个……我还在努力！",
                "zh-Hant": "這個……我還在努力！"
              },
              "id": 6,
              "speaker": {
                "id": 50173,
                "name": {
                  "zh-Hans": "莱丽娅"
                }
              }
            }
          ]
        }
      ]
    },
