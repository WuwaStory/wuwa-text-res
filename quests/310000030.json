          "stateId": 2,
          "talks": [
            {
              "text": {
                "de": "Hast du etwas gefunden?",
                "en": "Found anything?",
                "es": "¿Encontraste algo?",
                "fr": "Alors, as-tu trouvé quelque chose ?",
                "ja": "どう？何か見つかったか？",
                "ko": "어때요? 단서가 잡혔나요?",
                "th": "เป็นไง? หาเจอมั้ย?",
                "zh-Hans": "怎么样？有线索了吗？",
                "zh-Hant": "怎麼樣？ 有線索了嗎？"
              },
              "id": 1,
              "speaker": {
                "id": 740,
                "name": {
                  "zh-Hans": "兴白"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Er ist in die Richtung gegangen.",
                    "en": "He went in that direction.",
                    "es": "Fue en esa dirección.",
                    "fr": "Il est là-bas.",
                    "ja": "あっちに行ったみたい。",
                    "ko": "저쪽으로 달려갔어요",
                    "th": "มันวิ่งไปทางนั้นน่ะ",
                    "zh-Hans": "它跑到那边去了。",
                    "zh-Hant": "它跑到那邊去了。"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Okay, danke!",
                "en": "Okay, thanks!",
                "es": "¡Vale, gracias!",
                "fr": "D'accord, merci !",
                "ja": "わかった、ありがとう。",
                "ko": "아, 감사해요!",
                "th": "โอ้ ขอบคุณนะ!",
                "zh-Hans": "好嘞，谢谢！",
                "zh-Hant": "好嘞，謝謝！"
              },
