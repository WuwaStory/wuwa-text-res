      "dialogs": [
        {
          "flowId": "剧情_剧情_吱吱物流",
          "flowIndex": 14,
          "stateId": 1,
          "talks": [
            {
              "text": {
                "de": "Es ist mein Hund. Ich habe ihn auf eine Lieferung mitgenommen, aber er ist verschwunden, während ich nicht hingesehen habe.",
                "en": "It's my dog. I took him on a delivery, but he vanished while I wasn't watching.",
                "es": "Es mi perro. Lo llevé a una entrega, pero desapareció mientras no estaba mirando.",
                "fr": "C'est mon chien, je l'ai emmené pour livrer, mais il a disparu tout à l'heure, je l'ai perdu.",
                "ja": "俺が飼っている犬の名前だ。さっきまで一緒に荷物の配達してたんだが、急にいなくなって……どこに行ったんだ……",
                "ko": "제 강아지요. 제가 배달하면서 데리고 다녔는데, 갑자기 사라져버렸어요",
                "th": "สุนัขของฉันเอง ฉันพามันออกมาส่งสินค้าน่ะ แต่อยู่ดีๆ มันก็หายไป ฉันเลยตามหามันไม่เจอ",
                "zh-Hans": "是我的狗狗，我带它出来送货，结果这家伙刚才一溜烟没影了，我就跟丢了。",
                "zh-Hant": "是我的狗狗，我帶它出來送貨，結果這傢伙剛才一溜煙沒影了，我就跟丟了。"
              },
              "id": 1,
              "speaker": {
                "id": 740,
                "name": {
                  "zh-Hans": "兴白"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "Warum hast du ihn mitgebracht?",
                    "en": "Why did you bring him with you?",
                    "es": "¿Por qué lo trajiste contigo?",
                    "fr": "Pourquoi tu l'emmènes ? Tu dois travailler, n'est-ce pas ?",
                    "ja": "一緒に荷物の配達？",
                    "ko": "왜 배달하는 데 강아지를 데리고 다녀요?",
                    "th": "ทำไมไปส่งสินค้ายังต้องพามันมาด้วยล่ะ?",
                    "zh-Hans": "为什么送货还要带着它啊？",
                    "zh-Hant": "為什麼送貨還要帶著它啊？"
                  }
                }
              ]
            },
            {
              "text": {
                "de": "Ich wollte ihn einfach nicht einsperren, während ich draußen arbeite. Ich nenne es übrigens Fern-Hundespaziergang.",
                "en": "I just didn't want to shut him inside while I'm out working. I call it long-distance dog walking, by the way.",
                "es": "Solo no quería dejarlo encerrado mientras estoy fuera trabajando. Por cierto, lo llamo paseo de perros a larga distancia.",
                "fr": "Je l'ai emmené pour le promener, pour qu'il ne s'ennuie pas à la maison.",
                "ja": "ずっと家にいるのも退屈だと思って、ちょっと長いお散歩に連れて行こうと思ってな。",
                "ko": "집에서 혼자 있으면 심심할까 봐요... 강아지 산책도 시킬겸",
                "th": "ฉันกลัวมันอยู่บ้านแล้วจะเบื่อน่ะสิ ก็เลยพามันออกมาเดินเล่นไกลๆ หน่อย",
                "zh-Hans": "我这不是怕它在家里憋坏了吗，这叫长途遛狗。",
                "zh-Hant": "我這不是怕它在家裡憋壞了嗎，這叫長途遛狗。"
              },
              "id": 0,
              "speaker": {
                "id": 740,
                "name": {
                  "zh-Hans": "兴白"
                }
              },
              "options": [
                {
                  "text": {
                    "de": "...Ich helfe dir dabei, danach zu suchen.",
                    "en": "...I'll help you look for it.",
                    "es": "...Te ayudaré a buscarlo.",
                    "fr": "... Je vais t'aider à le chercher.",
                    "ja": "……なぜそんなことを……。",
                    "ko": "...제가 찾아줄게요",
                    "th": "ฉันจะช่วยตามหาเอง",
                    "zh-Hans": "……我帮你找找。",
                    "zh-Hant": "……我幫你找找。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
